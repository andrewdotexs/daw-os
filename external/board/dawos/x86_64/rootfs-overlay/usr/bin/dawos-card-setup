#!/bin/sh
# dawos-card-setup — bring the mixer of a sound card to a known state.
#
# A USB audio interface like the Scarlett 18i20 has a router and a mixer
# inside: which input reaches which capture channel, which playback
# channel reaches which output, at what level. The engine sees only
# channels, so what they carry must be known before it starts (step
# P1.4).
#
# The state is a text file, one control per line:
#
#   PCM 03 Capture Enum = Analogue 3
#   Line 03 Playback Volume = 127
#   Mute Playback Switch = off
#
# with the names and the values `amixer contents` shows; "#" starts a
# comment. The files of the cards dawOS knows are in
# /usr/share/dawos/cards, named after the USB identifier (1235-8201.conf).
#
# Usage:
#   dawos-card-setup show  [--card N]            every writable control, in
#                                                the format of a state file
#                                                (not the locked ones, nor
#                                                strings of bytes)
#   dawos-card-setup check [--card N] [FILE]     what differs from the file
#   dawos-card-setup apply [--card N] [FILE]     set what differs, then check
#   dawos-card-setup set   [--card N] NAME VALUE set one control
#
# Only controls that differ are written: on the Scarlett a change is also
# saved in the memory of the interface, and stays there when it is
# unplugged.
#
# Exit status: 0 the card is in the state of the file; 1 it is not, or a
# control or a value of the file does not exist; 2 usage, or no card.

set -u

PROG="dawos-card-setup"
CARDS_DIR=${DAWOS_CARDS_DIR:-/usr/share/dawos/cards}
AMIXER=${DAWOS_AMIXER:-amixer}
ASOUND=${DAWOS_ASOUND:-/proc/asound}

die() {
	echo "${PROG}: $*" >&2
	exit 2
}

usage() {
	sed -n '/^# Usage:/,/^#   dawos-card-setup set/p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

first_usb_card() {
	for directory in "${ASOUND}"/card[0-9]*; do
		[ -r "${directory}/usbid" ] || continue
		echo "${directory##*/card}"
		return 0
	done
	return 1
}

# The awk program behind every command. It reads the state file named by
# the variable "state" (may be empty), then the output of
# "amixer contents" on its input, and prints, according to "mode":
#
#   show     NAME = VALUE for every writable control
#   compare  one line per control of the file that is not as the file
#            says, fields separated by tabs:
#              DIFF     id  value-for-amixer  name  current  wanted
#              MISSING  -   -                 name  -        wanted
#              BADVALUE id  -                 name  current  wanted
#              READONLY id  -                 name  current  wanted
program() {
	cat << 'AWK'
function trim(text) {
	sub(/^[ \t]+/, "", text)
	sub(/[ \t]+$/, "", text)
	return text
}

# The control just read is complete: remember it.
function flush(    count, parts, i, shown) {
	if (name == "") return
	shown = raw
	if (type == "ENUMERATED") {
		count = split(raw, parts, ",")
		shown = ""
		for (i = 1; i <= count; i++)
			shown = shown (i > 1 ? "," : "") ((name SUBSEP parts[i]) in item ? item[name, parts[i]] : parts[i])
	}
	order[++controls] = name
	current[name] = shown
	kind[name] = type
	# Writable by us: not the controls another program keeps for itself
	# ("l", locked: fcp-server shows versions, the lock of the clock
	# and the fixed inputs of the mixer that way), and not strings of
	# bytes (the name the interface gives itself, which ends with
	# digits of its serial number and has no place in a state file).
	writable[name] = (access ~ /^rw/ && access !~ /^....l/ && type != "BYTES")
	ident[name] = id
	name = ""
}

# The value amixer wants for "wanted": the number of the item for a
# list, the value itself otherwise. Empty when an item does not exist.
function for_amixer(control, wanted,    count, parts, i, result) {
	if (kind[control] != "ENUMERATED") return wanted
	count = split(wanted, parts, ",")
	result = ""
	for (i = 1; i <= count; i++) {
		if (!((control SUBSEP "name" SUBSEP parts[i]) in item)) return ""
		result = result (i > 1 ? "," : "") item[control, "name", parts[i]]
	}
	return result
}

BEGIN {
	if (state != "") {
		while ((getline line < state) > 0) {
			sub(/[ \t]*#.*$/, "", line)
			if (trim(line) == "") continue
			split_at = index(line, " = ")
			if (split_at == 0) {
				printf "%s: line not understood: %s\n", state, line > "/dev/stderr"
				bad_file = 1
				continue
			}
			wanted_name = trim(substr(line, 1, split_at - 1))
			wanted_order[++wanted_count] = wanted_name
			wanted[wanted_name] = trim(substr(line, split_at + 3))
		}
		close(state)
	}
}

/^numid=/ {
	flush()
	id = $0
	sub(/^numid=[0-9]+,/, "", id)
	name = id
	sub(/^iface=[A-Z]+,name=\047/, "", name)
	# What follows the closing quote (",index=1", ",device=0") tells
	# apart controls of the same name: it stays in the name.
	if (match(name, /\047[^\047]*$/))
		name = substr(name, 1, RSTART - 1) substr(name, RSTART + 1)
	type = ""
	access = ""
	raw = ""
	next
}

/^  ; type=/ {
	type = $0
	sub(/^  ; type=/, "", type)
	sub(/,.*$/, "", type)
	access = $0
	sub(/^.*,access=/, "", access)
	sub(/,.*$/, "", access)
	next
}

/^  ; Item #[0-9]+ \047/ {
	number = $3
	sub(/^#/, "", number)
	label = $0
	sub(/^  ; Item #[0-9]+ \047/, "", label)
	sub(/\047$/, "", label)
	item[name, number] = label
	item[name, "name", label] = number
	next
}

/^  : values=/ {
	raw = $0
	sub(/^  : values=/, "", raw)
	next
}

END {
	flush()
	if (mode == "show") {
		for (i = 1; i <= controls; i++)
			if (writable[order[i]]) printf "%s = %s\n", order[i], current[order[i]]
		exit 0
	}
	for (i = 1; i <= wanted_count; i++) {
		control = wanted_order[i]
		if (!(control in current)) {
			printf "MISSING\t-\t-\t%s\t-\t%s\n", control, wanted[control]
			continue
		}
		if (current[control] == wanted[control]) continue
		if (!writable[control]) {
			printf "READONLY\t%s\t-\t%s\t%s\t%s\n", ident[control], control, current[control], wanted[control]
			continue
		}
		value = for_amixer(control, wanted[control])
		if (value == "") {
			printf "BADVALUE\t%s\t-\t%s\t%s\t%s\n", ident[control], control, current[control], wanted[control]
			continue
		}
		printf "DIFF\t%s\t%s\t%s\t%s\t%s\n", ident[control], value, control, current[control], wanted[control]
	}
	if (bad_file) printf "BADFILE\t-\t-\t-\t-\t-\n"
}
AWK
}

contents() {
	"${AMIXER}" -c "${card}" contents 2> /dev/null
}

# Lines of "compare" for the state file $1.
differences() {
	contents | awk -v mode=compare -v state="$1" "$(program)"
}

# Print what differs, in words. Returns 1 when something does.
#
# Of the controls the card does not have, the first five are named and
# the others counted: when the router of an interface is shown by a
# program and not by the kernel (fcp-server, for the Focusrite Control
# Protocol) and that program is not running, every control of the file
# is missing, and they are hundreds.
report() {
	result=0
	missing=0
	tab=$(printf '\t')
	while IFS="${tab}" read -r what _ _ control current wanted; do
		result=1
		case "${what}" in
		DIFF) echo "differs: ${control}: is '${current}', the file says '${wanted}'" ;;
		MISSING)
			missing=$((missing + 1))
			[ "${missing}" -gt 5 ] || echo "missing: the card has no control '${control}'"
			;;
		BADVALUE) echo "bad value: ${control}: '${wanted}' is not one of its values (it is '${current}')" ;;
		READONLY) echo "read-only: ${control}: is '${current}', the file says '${wanted}', and it cannot be set" ;;
		BADFILE) echo "the file has lines that were not understood" ;;
		esac
	done << EOF
$1
EOF
	if [ "${missing}" -gt 5 ]; then
		echo "missing: and $((missing - 5)) more controls of the file"
		echo "hint: is this the file of this card? For an interface of the Focusrite Control Protocol: is fcp-server@${card}.service running?"
	fi
	return "${result}"
}

do_check() {
	found=$(differences "${file}")
	if [ -z "${found}" ]; then
		echo "card ${card}: as ${file} says"
		return 0
	fi
	report "${found}"
	return 1
}

do_apply() {
	found=$(differences "${file}")
	tab=$(printf '\t')
	changed=0
	while IFS="${tab}" read -r what id value control current wanted; do
		[ "${what}" = DIFF ] || continue
		if "${AMIXER}" -q -c "${card}" cset "${id}" "${value}" > /dev/null 2>&1; then
			echo "set: ${control}: '${current}' -> '${wanted}'"
			changed=$((changed + 1))
		else
			echo "failed: ${control}: amixer refused '${wanted}'"
		fi
	done << EOF
${found}
EOF
	echo "controls changed: ${changed}"
	do_check
}

command=${1:-}
[ -n "${command}" ] || usage
shift
card=
if [ "${1:-}" = --card ]; then
	card=${2:-}
	[ -n "${card}" ] || usage
	shift 2
fi
if [ -z "${card}" ]; then
	card=$(first_usb_card) || die "no USB sound card: is the interface connected? (see ${ASOUND}/cards)"
fi
[ -d "${ASOUND}/card${card}" ] || die "there is no sound card ${card}"

# The state file: the one named, or the one of this model.
choose_file() {
	file=${1:-}
	if [ -z "${file}" ]; then
		model=$(tr ':' '-' < "${ASOUND}/card${card}/usbid" 2> /dev/null)
		file="${CARDS_DIR}/${model}.conf"
		[ -r "${file}" ] || die "no state file for this card (${model:-not a USB card}): name one"
	fi
	[ -r "${file}" ] || die "cannot read ${file}"
}

case "${command}" in
show)
	contents | awk -v mode=show -v state="" "$(program)"
	;;
check)
	choose_file "${1:-}"
	do_check
	;;
apply)
	choose_file "${1:-}"
	do_apply
	;;
set)
	[ $# -eq 2 ] || usage
	file=$(mktemp)
	trap 'rm -f "${file}"' EXIT
	echo "$1 = $2" > "${file}"
	do_apply
	;;
*) usage ;;
esac
