# dawOS disk images.
# Template: post-image.sh replaces @VERSION@ and @ROOT_SLOT_SIZE@.
#
#   disk.img       the installed system, for QEMU;
#   installer.img  the installation medium, to be written to a USB stick.
#
# The real NVMe is not written from either image: dawos-install, run from
# the installation medium, partitions it with the full layout of
# document 0, section 3.3.

image efi-part.vfat {
	vfat {
		extraargs = "-n ESP"

		file EFI {
			image = "efi-part/EFI"
		}

		file loader {
			image = "efi-part/loader"
		}
	}

	size = 256M
}

# Empty "state" file system for the QEMU disk, so that the image used by
# "make qemu-test" mounts /var the way an installed machine does. On a
# real disk dawos-install creates this partition, 32 GiB.
image state.ext4 {
	ext4 {
		label = "state"
	}
	empty = true
	size = 256M
}

image disk.img {
	hdimage {
		partition-table-type = "gpt"
	}

	partition esp {
		image = "efi-part.vfat"
		# "U" is genimage shorthand for the EFI System Partition type.
		partition-type-uuid = U
		offset = 1M
		bootable = true
	}

	# The label carries the version: it is how the kernel command line
	# finds its own root, and later how systemd-sysupdate picks a slot.
	partition "dawos-root-@VERSION@" {
		# Discoverable Partitions Specification: root, x86-64.
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		image = "rootfs.erofs"
		size = @ROOT_SLOT_SIZE@
	}

	# Hash tree of the root partition (dm-verity), found by its label
	# from the kernel command line like the root itself.
	partition "dawos-verity-@VERSION@" {
		# Discoverable Partitions Specification: root verity, x86-64.
		partition-type-uuid = 2c7357ed-ebd2-46d9-aec1-23d437ec2bf5
		image = "rootfs.verity"
		size = 128M
	}

	# Slot B, free: the place an update is written to. post-image.sh
	# renames both partitions to "_empty", the label systemd-sysupdate
	# looks for. Sized as on the real disk; the image file is sparse.
	partition dawos-free-root {
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		size = @ROOT_SLOT_SIZE@
	}

	partition dawos-free-verity {
		partition-type-uuid = 2c7357ed-ebd2-46d9-aec1-23d437ec2bf5
		size = 128M
	}

	# Found by its name by dawos-var-generator.
	partition state {
		# Generic Linux data, as dawos-install declares it.
		partition-type-uuid = L
		image = "state.ext4"
	}
}

# --- A/B test image -----------------------------------------------------------
# A disk as it is after an update: the current system image in slot A,
# already marked good, and a newer one in slot B, still under assessment.
# "make qemu-ab-test" boots it, once as it is and once with slot B damaged,
# to see the boot loader fall back to slot A. The "newer" image is this
# same build under the version "@VERSION@b".

image efi-ab.vfat {
	vfat {
		extraargs = "-n ESP"

		file EFI {
			image = "efi-ab/EFI"
		}

		file loader {
			image = "efi-ab/loader"
		}
	}

	size = 256M
}

image ab-test.img {
	hdimage {
		partition-table-type = "gpt"
	}

	partition esp {
		image = "efi-ab.vfat"
		partition-type-uuid = U
		offset = 1M
		bootable = true
	}

	partition "dawos-root-@VERSION@" {
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		image = "rootfs.erofs"
		size = 128M
	}

	partition "dawos-verity-@VERSION@" {
		partition-type-uuid = 2c7357ed-ebd2-46d9-aec1-23d437ec2bf5
		image = "rootfs.verity"
		size = 16M
	}

	partition "dawos-root-@VERSION@b" {
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		image = "rootfs.erofs"
		size = 128M
	}

	partition "dawos-verity-@VERSION@b" {
		partition-type-uuid = 2c7357ed-ebd2-46d9-aec1-23d437ec2bf5
		image = "rootfs.verity"
		size = 16M
	}

	partition state {
		partition-type-uuid = L
		image = "state.ext4"
	}
}

# --- Installation medium ------------------------------------------------------

image installer-esp.vfat {
	vfat {
		extraargs = "-n DAWOSINST"

		file EFI {
			image = "efi-inst/EFI"
		}

		file loader {
			image = "efi-inst/loader"
		}

		file dawos {
			image = "efi-inst/dawos"
		}
	}

	size = 128M
}

image installer.img {
	hdimage {
		partition-table-type = "gpt"
	}

	# Not called "esp": the installer must tell this partition from the
	# one it creates on the target disk.
	partition "dawos-inst-esp" {
		image = "installer-esp.vfat"
		partition-type-uuid = U
		offset = 1M
		bootable = true
	}

	# A different label from the installed system ("dawos-root-..."):
	# the kernel finds its root by label, and the stick must never be
	# confused with a disk that already holds the same version.
	# No explicit size: the partition is as large as the image, so the
	# stick is written in seconds.
	partition "dawos-inst-@VERSION@" {
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		image = "rootfs.erofs"
	}

	# Its hash tree: the medium boots verified, and dawos-install copies
	# this partition to the disk next to the root.
	partition "dawos-instv-@VERSION@" {
		partition-type-uuid = 2c7357ed-ebd2-46d9-aec1-23d437ec2bf5
		image = "rootfs.verity"
	}
}
