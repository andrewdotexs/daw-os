#!/bin/sh
# dawos-cgroup-test — ask the kernel the questions the placement of the
# audio threads depends on (experiment E-03, ADR 0002).
#
# dawOS isolates the live CPUs at boot (isolcpus) and lets every thread
# place itself with sched_setaffinity, one control group per process.
# The alternative is to isolate CPUs at run time, with an "isolated
# partition" of control groups (cpuset), which can be resized without a
# reboot. Whether that alternative can hold the live threads of several
# processes, each with its own limits, is decided by a handful of kernel
# rules. This tool tries each of them and writes down what the kernel
# answers, next to the answer the design assumes:
#
#   1  a partition under a parent that is not one: refused?
#   2  a "threaded" control group as the root of an isolated partition
#      (declared from the top of the tree, with cpuset.cpus.exclusive)
#   3  the threads of one process in two threaded groups, one of which
#      is the partition: does each get its own CPUs?
#   4  sched_setaffinity across the border of the partition, both ways
#   5  limits of the process: which controllers still work at the group
#      of the process, and which can be switched on below it
#   6  a thread of a second process into the partition of the first
#   7  a second partition on the same CPU, for the second process
#   8  a thread of the second process onto that CPU by affinity alone
#   9  the arrangement dawOS uses: a service with its own limits, one
#      real-time thread on a live CPU and the main thread elsewhere
#
# Everything is created under /sys/fs/cgroup/dawos-test and removed at
# the end; one CPU leaves the scheduler's domains for a few seconds and
# then comes back. Nothing is written to disk but the report. A reboot
# undoes anything a crash of this script might leave behind.
#
# The answers are those of the running kernel: this is also the check to
# repeat after a change of kernel version. Timing plays no part, so it
# runs in a virtual machine as well as on a real one.
#
# Results go to /var/lib/dawos/measure/cgroup-<time>[-LABEL].

set -u

PROG=dawos-cgroup-test
BASE=/var/lib/dawos/measure
CG=/sys/fs/cgroup
TEST=${CG}/dawos-test
UNIT=dawos-cgroup-test-static
CPU_DIR=/sys/devices/system/cpu

usage() {
	cat <<USAGE
Usage:
  ${PROG} [--cpu N] [LABEL]   run the questions; N is the CPU lent to the
                              test partition (default: the last CPU of the
                              "preemptive" domain, or the last CPU)
  ${PROG} --status            show the last report
USAGE
}

die() {
	echo "${PROG}: $*" >&2
	exit 1
}

# CPUs of a kernel list ("4-7", "0-3,8-15"), one per line, sorted.
expand_list() {
	echo "$1" | tr ',' '\n' | while IFS=- read -r first last; do
		case "${first}" in
		'' | *[!0-9]*) continue ;;
		esac
		seq "${first}" "${last:-${first}}"
	done | sort -n -u
}

log() {
	echo "$*" >> "${dir}/log.txt"
}

# Write $2 to the file $1. The outcome goes to the log, and the error
# text of a refusal to $refusal ("" when the write succeeded).
put() {
	if refusal=$(printf '%s\n' "$2" 2>&1 > "$1"); then
		refusal=
		log "write '$2' > ${1#"${CG}"/}: ok"
		return 0
	fi
	refusal=${refusal##*: }
	log "write '$2' > ${1#"${CG}"/}: refused: ${refusal}"
	return 1
}

# Content of the file $1 on one line; also logged.
get() {
	content=$(tr '\n' ' ' < "$1" 2> /dev/null | sed 's/ *$//')
	log "read ${1#"${CG}"/} = ${content}"
	echo "${content}"
}

# The CPUs thread $1 may run on, as a list.
allowed_cpus() {
	taskset -pc "$1" 2> /dev/null | sed -n 's/.*: //p'
}

# Ask for the affinity $2 for thread $1: "accepted" or "refused"; the
# kernel's own words go to the log.
ask_affinity() {
	if reply=$(taskset -pc "$2" "$1" 2>&1); then
		log "taskset -pc $2 $1: accepted"
		echo accepted
	else
		log "taskset -pc $2 $1: $(echo "${reply}" | tr '\n' ' ')"
		echo refused
	fi
}

# One line per thread of process $1: number, CPUs, scheduling, group.
threads_of() {
	for task in "/proc/$1/task"/*; do
		[ -d "${task}" ] || continue
		tid=${task##*/}
		policy=$(chrt -p "${tid}" 2> /dev/null | sed -n 's/.*policy: //p')
		priority=$(chrt -p "${tid}" 2> /dev/null | sed -n 's/.*priority: //p')
		echo "tid ${tid} cpus $(allowed_cpus "${tid}") ${policy:-?}/${priority:-?} group $(cut -d: -f3 "${task}/cgroup" 2> /dev/null)"
	done
}

# Thread numbers of process $1 other than its main thread.
other_threads() {
	for task in "/proc/$1/task"/*; do
		[ "${task##*/}" = "$1" ] || echo "${task##*/}"
	done
}

# Start cyclictest with $1 measurement threads and wait until they
# exist; its process number goes to $started.
start_threads() {
	cyclictest -q -t "$1" -p 80 -i 10000 -D 120 > /dev/null 2>&1 &
	started=$!
	helpers="${helpers} ${started}"
	waited=0
	while [ "$(other_threads "${started}" | wc -l)" -lt "$1" ] && [ "${waited}" -lt 20 ]; do
		sleep 1
		waited=$((waited + 1))
	done
	[ "$(other_threads "${started}" | wc -l)" -ge "$1" ]
}

# Record one answer: number, short name, what the kernel said, what the
# design expects. An answer that differs is counted.
answer() {
	if [ "$3" = "$4" ]; then
		mark="as expected"
	else
		mark="DIFFERENT (expected: $4)"
		differences=$((differences + 1))
	fi
	printf '%-2s %-44s %s -> %s\n' "$1" "$2:" "$3" "${mark}" >> "${dir}/answers.txt"
}

cleanup() {
	trap - EXIT
	# shellcheck disable=SC2086 # a list of process numbers
	[ -z "${helpers}" ] || kill ${helpers} 2> /dev/null
	systemctl stop "${UNIT}" 2> /dev/null
	sleep 1
	for group in "${TEST}/first/live" "${TEST}/second/live" "${TEST}/plain"; do
		[ -d "${group}" ] && echo member > "${group}/cpuset.cpus.partition" 2> /dev/null
	done
	for group in "${TEST}/first/live" "${TEST}/first/rest" "${TEST}/first" \
		"${TEST}/second/live" "${TEST}/second/rest" "${TEST}/second" "${TEST}/plain" "${TEST}"; do
		[ -d "${group}" ] || continue
		rmdir "${group}" 2> /dev/null || echo "left behind: ${group}" >> "${dir}/log.txt"
	done
	for switched in ${enabled_here}; do
		echo "${switched}" > "${CG}/cgroup.subtree_control" 2> /dev/null
	done
}

label=
cpu=
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--status)
		latest=
		for candidate in "${BASE}"/cgroup-*; do
			[ -d "${candidate}" ] && latest=${candidate}
		done
		[ -n "${latest}" ] || die "no report yet"
		cat "${latest}/report.txt"
		exit 0
		;;
	--cpu)
		cpu=${2:-}
		shift
		;;
	-*) die "unknown option '$1' (try --help)" ;;
	*) label=$1 ;;
	esac
	shift
done

[ "$(id -u)" = 0 ] || die "must run as root"
if [ -n "${label}" ]; then
	echo "${label}" | grep -Eq '^[A-Za-z0-9_-]+$' || die "the label may only contain letters, digits, '-' and '_'"
fi
for tool in taskset chrt cyclictest systemd-run; do
	command -v "${tool}" > /dev/null || die "'${tool}' not found: this needs the dev variant of the image"
done
[ -r "${CG}/cgroup.controllers" ] || die "${CG} is not a cgroup v2 tree"
grep -qw cpuset "${CG}/cgroup.controllers" || die "the kernel has no cpuset controller"
# A partition changes the scheduler's domains: not under a measurement.
for other in dawos-osnoise dawos-hwnoise dawos-wakeup dawos-freq-sweep dawos-thermal-sweep; do
	systemctl is-active --quiet "${other}" && die "'${other}' is running: wait for it, or stop it"
done
[ ! -d "${TEST}" ] || die "${TEST} exists already: a previous run did not finish (reboot, or remove it by hand)"

online=$(cat "${CPU_DIR}/online")
isolated=$(grep -v null "${CPU_DIR}/isolated" 2> /dev/null)
if [ -z "${cpu}" ]; then
	preemptive=$(sed -n 's/^    "preemptive": "\(.*\)".*/\1/p' /run/dawos/topology.json 2> /dev/null)
	cpu=$(expand_list "${preemptive:-${online}}" | tail -n 1)
fi
echo "${cpu}" | grep -Eq '^[0-9]+$' || die "bad CPU '${cpu}'"
expand_list "${online}" | grep -qx "${cpu}" || die "CPU ${cpu} is not online"
[ "${cpu}" != 0 ] || die "CPU 0 cannot be lent to the test"
if expand_list "${isolated}" | grep -qx "${cpu}"; then
	die "CPU ${cpu} is isolated by the kernel already: choose one that is not"
fi
# A CPU outside the partition, for the threads that stay out.
outside=$(expand_list "${online}" | grep -vx "${cpu}" | grep -vx 0 | head -n 1)
[ -n "${outside}" ] || die "this needs at least three CPUs"

dir="${BASE}/cgroup-$(date -u +%Y%m%dT%H%M%SZ)${label:+-${label}}"
mkdir -p "${dir}" || die "could not create ${dir}"
: > "${dir}/answers.txt"
: > "${dir}/log.txt"
differences=0
helpers=
enabled_here=
trap cleanup EXIT
trap 'exit 1' INT TERM HUP

# The cpuset controller below the root, for the time of the test.
grep -qw cpuset "${CG}/cgroup.subtree_control" || {
	put "${CG}/cgroup.subtree_control" "+cpuset" || die "could not enable the cpuset controller: ${refusal}"
	enabled_here=-cpuset
}
mkdir "${TEST}" || die "could not create ${TEST}"
put "${TEST}/cgroup.subtree_control" "+cpuset +pids" || die "could not enable controllers in ${TEST}: ${refusal}"
# Controllers that count resources of whole processes ("domain"
# controllers: memory, io, ...) that this kernel has.
domain_controllers=
for controller in memory io hugetlb; do
	grep -qw "${controller}" "${CG}/cgroup.controllers" && domain_controllers="${domain_controllers} ${controller}"
done
domain_controllers=${domain_controllers# }

# --- 1: a partition under a parent that is not one ---------------------------------
mkdir "${TEST}/plain"
put "${TEST}/plain/cpuset.cpus" "${cpu}"
put "${TEST}/plain/cpuset.cpus.partition" isolated
state=$(get "${TEST}/plain/cpuset.cpus.partition")
case "${state}" in
isolated) result="valid" ;;
*invalid*) result="invalid" ;;
*) result="${state:-refused (${refusal})}" ;;
esac
answer 1 "partition under a plain parent" "${result}" "invalid"
put "${TEST}/plain/cpuset.cpus.partition" member
rmdir "${TEST}/plain"

# --- 2: a threaded group as the root of an isolated partition --------------------
# The group of the process ("first") with two threaded children; the CPU
# is handed down from the top with cpuset.cpus.exclusive.
mkdir -p "${TEST}/first/live" "${TEST}/first/rest"
put "${TEST}/first/live/cgroup.type" threaded
put "${TEST}/first/rest/cgroup.type" threaded
log "first is now: $(get "${TEST}/first/cgroup.type")"
put "${TEST}/first/cgroup.subtree_control" "+cpuset"
put "${TEST}/cpuset.cpus.exclusive" "${cpu}"
put "${TEST}/first/cpuset.cpus.exclusive" "${cpu}"
put "${TEST}/first/live/cpuset.cpus.exclusive" "${cpu}"
put "${TEST}/first/live/cpuset.cpus.partition" isolated
state=$(get "${TEST}/first/live/cpuset.cpus.partition")
case "${state}" in
isolated) result="valid" ;;
*invalid*) result="invalid" ;;
*) result="${state:-refused (${refusal})}" ;;
esac
partition=${result}
answer 2 "threaded group as partition root" "${result}" "valid"
log "root: isolated CPUs $(get "${CG}/cpuset.cpus.isolated"), effective $(get "${CG}/cpuset.cpus.effective")"

# --- 3: the threads of one process in two groups -----------------------------------
if start_threads 2; then
	first=${started}
	put "${TEST}/first/cgroup.procs" "${first}"
	first_live=$(other_threads "${first}" | head -n 1)
	put "${TEST}/first/live/cgroup.threads" "${first_live}"
	put "${TEST}/first/rest/cgroup.threads" "${first}"
	threads_of "${first}" >> "${dir}/log.txt"
	inside=$(allowed_cpus "${first_live}")
	if [ "${inside}" = "${cpu}" ] && ! expand_list "$(allowed_cpus "${first}")" | grep -qx "${cpu}"; then
		result="each its own CPUs"
	else
		result="live thread on ${inside:-?}, main thread on $(allowed_cpus "${first}")"
	fi
	answer 3 "threads of one process, two groups" "${result}" "each its own CPUs"

	# --- 4: affinity across the border ---------------------------------------------
	answer 4a "affinity from the partition outwards" "$(ask_affinity "${first_live}" "${outside}")" "refused"
	answer 4b "affinity into the partition" "$(ask_affinity "${first}" "${cpu}")" "refused"
else
	answer 3 "threads of one process, two groups" "could not start the test process" "each its own CPUs"
fi

# --- 5: limits of the process ------------------------------------------------------
if put "${TEST}/first/pids.max" 64; then result="works"; else result="refused (${refusal})"; fi
answer 5a "limit at the group of the process" "${result}" "works"
if [ -n "${domain_controllers}" ]; then
	controller=${domain_controllers%% *}
	# It has to be handed down from the root first.
	if ! grep -qw "${controller}" "${CG}/cgroup.subtree_control" && put "${CG}/cgroup.subtree_control" "+${controller}"; then
		enabled_here="${enabled_here} -${controller}"
	fi
	put "${TEST}/cgroup.subtree_control" "+${controller}"
	if grep -qw "${controller}" "${TEST}/first/cgroup.controllers"; then result="works"; else result="missing"; fi
	answer 5b "'${controller}' at the group of the process" "${result}" "works"
	if put "${TEST}/first/cgroup.subtree_control" "+${controller}"; then result="accepted"; else result="refused"; fi
	answer 5c "'${controller}' below the group of the process" "${result}" "refused"
else
	echo "5b no domain controller (memory, io, hugetlb) in this kernel: not asked" >> "${dir}/answers.txt"
fi

# --- 6, 7, 8: a second process -----------------------------------------------------
mkdir -p "${TEST}/second/live" "${TEST}/second/rest"
put "${TEST}/second/live/cgroup.type" threaded
put "${TEST}/second/rest/cgroup.type" threaded
put "${TEST}/second/cgroup.subtree_control" "+cpuset"
if start_threads 1; then
	second=${started}
	put "${TEST}/second/cgroup.procs" "${second}"
	second_live=$(other_threads "${second}" | head -n 1)
	if put "${TEST}/first/live/cgroup.threads" "${second_live}"; then result="accepted"; else result="refused"; fi
	answer 6 "thread of a second process, same partition" "${result}" "refused"

	put "${TEST}/second/cpuset.cpus.exclusive" "${cpu}"
	put "${TEST}/second/live/cpuset.cpus.exclusive" "${cpu}"
	put "${TEST}/second/live/cpuset.cpus.partition" isolated
	state=$(get "${TEST}/second/live/cpuset.cpus.partition")
	case "${state}" in
	isolated) result="valid" ;;
	*invalid*) result="invalid" ;;
	*) result="${state:-refused (${refusal})}" ;;
	esac
	answer 7 "second partition on the same CPU" "${result}" "invalid"

	answer 8 "thread of the second, by affinity" "$(ask_affinity "${second_live}" "${cpu}")" "refused"
else
	answer 6 "thread of a second process, same partition" "could not start the test process" "refused"
fi

# Everything back before the last question.
# shellcheck disable=SC2086 # a list of process numbers
kill ${helpers} 2> /dev/null
helpers=
sleep 1
put "${TEST}/first/live/cpuset.cpus.partition" member
put "${TEST}/second/live/cpuset.cpus.partition" member
log "root after the partitions: effective $(get "${CG}/cpuset.cpus.effective")"

# --- 9: the arrangement dawOS uses -------------------------------------------------
# A service of its own, with a limit on the number of tasks (and on
# memory where the kernel can count it); inside it one real-time thread
# on a live CPU, placed by the process itself, and the main thread on
# another CPU. With a boot profile the live CPU is one the kernel
# isolated; without, the CPU lent to this test stands in for it.
live=$(expand_list "${isolated}" | head -n 1)
live=${live:-${cpu}}
main=$(expand_list "${online}" | grep -vx "${live}" | grep -vx 0 | while read -r candidate; do
	expand_list "${isolated}" | grep -qx "${candidate}" || echo "${candidate}"
done | head -n 1)
limits="-p TasksMax=16"
grep -qw memory "${CG}/cgroup.controllers" && limits="${limits} -p MemoryMax=64M"
# shellcheck disable=SC2086 # the limits are separate words
if systemd-run --quiet --collect --unit="${UNIT}" ${limits} \
	cyclictest -q -t 1 -a "${live}" --mainaffinity="${main}" -p 80 -i 10000 -D 60 2>> "${dir}/log.txt"; then
	service=
	waited=0
	while [ "${waited}" -lt 20 ]; do
		service=$(systemctl show -p MainPID --value "${UNIT}" 2> /dev/null)
		[ -n "${service}" ] && [ "${service}" != 0 ] && [ -n "$(other_threads "${service}")" ] && break
		sleep 1
		waited=$((waited + 1))
	done
	if [ -n "${service}" ] && [ "${service}" != 0 ] && [ -n "$(other_threads "${service}")" ]; then
		threads_of "${service}" >> "${dir}/log.txt"
		worker=$(other_threads "${service}" | head -n 1)
		group=$(cut -d: -f3 "/proc/${service}/cgroup")
		log "service group ${group}: pids.max $(get "${CG}${group}/pids.max")"
		worker_policy=$(chrt -p "${worker}" | sed -n 's/.*policy: //p')
		if [ "$(allowed_cpus "${worker}")" = "${live}" ] && [ "$(allowed_cpus "${service}")" = "${main}" ] &&
			[ "${worker_policy}" = SCHED_FIFO ] && [ "$(cat "${CG}${group}/pids.max")" = 16 ] &&
			[ "$(cut -d: -f3 "/proc/${service}/task/${worker}/cgroup")" = "${group}" ]; then
			result="works"
		else
			result="thread on $(allowed_cpus "${worker}") (${worker_policy}), main on $(allowed_cpus "${service}"), pids.max $(cat "${CG}${group}/pids.max")"
		fi
	else
		result="the service did not start its thread"
	fi
	systemctl stop "${UNIT}" 2> /dev/null
else
	result="could not start the service"
fi
answer 9 "one service, live thread by affinity" "${result}" "works"

# --- Report -----------------------------------------------------------------------
{
	echo "directory: ${dir}"
	date -u '+date_utc: %Y-%m-%dT%H:%M:%SZ'
	echo "label: ${label:-none}"
	echo "kernel: $(uname -srv)"
	echo "profile: $(sed -n 's/.*dawos\.profile=\([a-z0-9-]*\).*/\1/p' /proc/cmdline)"
	echo "image: $(sed -n 's/^BUILD_ID=//p' /etc/os-release)"
	echo "cpus_online: ${online}"
	echo "cpus_isolated_by_kernel: ${isolated:-none}"
	echo "cpu_lent_to_the_partition: ${cpu}"
	echo "live_cpu_of_question_9: ${live} (main thread on ${main})"
	echo "controllers: $(cat "${CG}/cgroup.controllers")"
	echo "domain_controllers: ${domain_controllers:-none}"
	echo "memory_controller: $(if grep -qw memory "${CG}/cgroup.controllers"; then echo present; else echo "absent (the kernel is built without it)"; fi)"
	echo "threaded_partition: ${partition}"
	echo
	cat "${dir}/answers.txt"
	echo
	if [ "${differences}" -eq 0 ]; then
		echo "verdict: every answer is the one the design expects"
	else
		echo "verdict: ${differences} answer(s) differ from what the design expects"
	fi
} > "${dir}/report.txt"
cat "${dir}/report.txt"
[ "${differences}" -eq 0 ]
