load    t14.2    class=light
load    t14.3    class=light
connect t14 -> t14.1:0 -> t14.2:0 -> t14.3:0 -> mix
connect t14 -> t14.1:1
connect t14.1:1 -> t14.2:1
connect t14.2:1 -> t14.3:1

noise   t15      seed=15
load    t15.1    class=light
load    t15.2    class=light
load    t15.3    class=light
connect t15 -> t15.1:0 -> t15.2:0 -> t15.3:0 -> mix
connect t15 -> t15.1:1
connect t15.1:1 -> t15.2:1
connect t15.2:1 -> t15.3:1

noise   t16      seed=16
load    t16.1    class=light
load    t16.2    class=medium
load    t16.3    class=medium
connect t16 -> t16.1:0 -> t16.2:0 -> t16.3:0 -> mix
connect t16 -> t16.1:1
connect t16.1:1 -> t16.2:1
connect t16.2:1 -> t16.3:1

bus     mix
peak    meter
connect mix -> meter
