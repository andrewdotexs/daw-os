connect t5 -> t5.1:1
connect t5.1:1 -> t5.2:1
connect t5.2:1 -> t5.3:1

noise   t6      seed=6
load    t6.1     class=light
load    t6.2     class=medium
load    t6.3     class=medium
connect t6 -> t6.1:0 -> t6.2:0 -> t6.3:0 -> mix
connect t6 -> t6.1:1
connect t6.1:1 -> t6.2:1
connect t6.2:1 -> t6.3:1

noise   t7      seed=7
load    t7.1     class=medium
load    t7.2     class=heavy
load    t7.3     class=light
connect t7 -> t7.1:0 -> t7.2:0 -> t7.3:0 -> mix
connect t7 -> t7.1:1
connect t7.1:1 -> t7.2:1
connect t7.2:1 -> t7.3:1

noise   t8      seed=8
load    t8.1     class=light
load    t8.2     class=light
load    t8.3     class=light
connect t8 -> t8.1:0 -> t8.2:0 -> t8.3:0 -> mix
connect t8 -> t8.1:1
connect t8.1:1 -> t8.2:1
connect t8.2:1 -> t8.3:1

noise   t9      seed=9
load    t9.1     class=light
load    t9.2     class=light
load    t9.3     class=medium
connect t9 -> t9.1:0 -> t9.2:0 -> t9.3:0 -> mix
connect t9 -> t9.1:1
connect t9.1:1 -> t9.2:1
connect t9.2:1 -> t9.3:1

noise   t10      seed=10
load    t10.1    class=medium
load    t10.2    class=medium
load    t10.3    class=heavy
connect t10 -> t10.1:0 -> t10.2:0 -> t10.3:0 -> mix
connect t10 -> t10.1:1
connect t10.1:1 -> t10.2:1
connect t10.2:1 -> t10.3:1

noise   t11      seed=11
