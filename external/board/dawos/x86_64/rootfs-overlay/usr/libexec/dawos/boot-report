#!/bin/sh
# dawOS boot report: one line with what an automated boot test needs.
#
# Output format (single line, space-separated key=value pairs):
#   DAWOS-BOOT-REPORT version=<v> variant=<v> kernel=<r> realtime=<0|1> secureboot=<0|1> verity=<0|1> rootpart=<label> timers=<none|names> var=<state|tmpfs|none> failed_units=<n> uptime_s=<s>

set -eu

# IMAGE_VERSION and VARIANT_ID are written by post-build.sh.
# shellcheck source=/dev/null
. /etc/os-release

# Units in "failed" state right now. The report itself is still running,
# so "systemctl is-system-running" would only ever say "starting" here.
failed=$(systemctl list-units --state=failed --no-legend --plain | wc -l)

# 1 when the running kernel is a PREEMPT_RT kernel. The kernel says so in
# its version string. (The /sys/kernel/realtime file known from the
# out-of-tree RT patches does not exist in mainline 6.18.)
case "$(uname -v)" in
*PREEMPT_RT*) realtime=1 ;;
*) realtime=0 ;;
esac

# 1 when the firmware started this system with Secure Boot enforced. The
# UEFI variable holds four bytes of attributes, then one byte: 1 = on.
secureboot=0
sb_var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
# (The fifth number of the dump: the od of busybox has no -j and -N.)
if [ -r "${sb_var}" ] && [ "$(od -An -tu1 "${sb_var}" | awk 'NR == 1 { print $5 }')" = 1 ]; then
	secureboot=1
fi

# 1 when the root file system is the device-mapper device "dawos-root",
# which the kernel builds from the dm-verity table on its command line,
# and that device reports itself as verified: its status line then reads
# "0 <sectors> verity V" (it would end in "C" after a corrupted block).
verity=0
root_dev=$(mountpoint -d /)
for dm in /sys/block/dm-*; do
	[ -r "${dm}/dev" ] || continue
	[ -r "${dm}/dm/name" ] || continue
	if [ "$(cat "${dm}/dev")" = "${root_dev}" ] && [ "$(cat "${dm}/dm/name")" = dawos-root ]; then
		case "$(dmsetup status dawos-root 2> /dev/null)" in
		*" verity V"*) verity=1 ;;
		esac
	fi
done

# GPT name of the root partition in use, as on the kernel command line:
# it carries the version, so it tells which system image, and therefore
# which slot, is running.
rootpart=$(sed -n 's/.*PARTLABEL=\(dawos-root-[A-Za-z0-9._+-]*\).*/\1/p' /proc/cmdline)
[ -n "${rootpart}" ] ||
	rootpart=$(sed -n 's/.*PARTLABEL=\(dawos-inst-[A-Za-z0-9._+-]*\).*/\1/p' /proc/cmdline)

# Timers that are armed. A workstation that records must not start work
# on its own schedule: the only timer allowed is the daily clean-up of
# temporary files. Anything else is named here, so that a package that
# brings a timer along is noticed by the tests.
timers=$(systemctl list-units --type=timer --state=active --no-legend --plain |
	awk '$1 != "systemd-tmpfiles-clean.timer" { printf "%s%s", sep, $1; sep = "," }')

# Where /var lives: "state" when it is the persistent partition, "tmpfs"
# when it is in memory (installation medium, image without a state
# partition), "none" when nothing is mounted there, which is a fault.
var=none
while read -r _ where fstype _; do
	[ "${where}" = /var ] || continue
	case "${fstype}" in
	tmpfs) var=tmpfs ;;
	*) var=state ;;
	esac
done < /proc/mounts

# Seconds since the kernel started, as a cheap boot-time indicator.
# The authoritative figure is "systemd-analyze", run by hand.
read -r uptime _ < /proc/uptime

printf 'DAWOS-BOOT-REPORT version=%s variant=%s kernel=%s realtime=%s secureboot=%s verity=%s rootpart=%s timers=%s var=%s failed_units=%s uptime_s=%s\n' \
	"${IMAGE_VERSION:-unknown}" "${VARIANT_ID:-unknown}" "$(uname -r)" "${realtime}" "${secureboot}" "${verity}" "${rootpart:-unknown}" "${timers:-none}" "${var}" "${failed}" "${uptime}"
