# dawOS kernel fragment: minimal x86-64 platform.
# Applied on top of the architecture default (x86_64_defconfig), 6.18.y.

# Identify our builds in "uname -r"; no git suffix so the string is stable.
CONFIG_LOCALVERSION="-dawos"
# CONFIG_LOCALVERSION_AUTO is not set

# UEFI boot: the kernel image is itself an EFI executable.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y

# Interrupt remapping (Intel VT-d). Recent Intel desktop firmware hands the
# machine over with the local APIC locked in x2APIC mode. On bare metal
# the kernel only keeps x2APIC when interrupt remapping is available, and
# it cannot switch a locked x2APIC off: without this option the reference
# machine panics 0.16 s into the boot, in setup_IO_APIC, right after
# "Cannot disable locked x2apic". Needs VT-d enabled in the firmware.
CONFIG_X86_X2APIC=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
# Only interrupt remapping: DMA remapping stays off unless asked for with
# intel_iommu=on, because it adds work to every DMA mapping. To be decided
# with the threat model (DMA attacks over Thunderbolt), not here.
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set

# Consoles available before any native graphics driver: firmware
# framebuffer on screen, 8250 UART for QEMU and for debugging.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# systemd expects a kernel-populated /dev.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# systemd confines the network access of each service with cgroup BPF
# programs (IPAddressAllow=/IPAddressDeny=): without these options it only
# logs a warning and applies nothing. Unprivileged BPF stays off, and the
# JIT is mandatory so that no in-kernel interpreter is left to abuse.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# Make the running configuration readable from /proc/config.gz, so every
# measurement report can archive the exact configuration it ran on.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
