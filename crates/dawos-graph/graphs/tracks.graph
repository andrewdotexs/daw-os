load    t11.2    class=light
load    t11.3    class=light
connect t11 -> t11.1:0 -> t11.2:0 -> t11.3:0 -> mix
connect t11 -> t11.1:1
connect t11.1:1 -> t11.2:1
connect t11.2:1 -> t11.3:1

noise   t12      seed=12
load    t12.1    class=light
load    t12.2    class=light
load    t12.3    class=light
connect t12 -> t12.1:0 -> t12.2:0 -> t12.3:0 -> mix
connect t12 -> t12.1:1
connect t12.1:1 -> t12.2:1
connect t12.2:1 -> t12.3:1

noise   t13      seed=13
load    t13.1    class=medium
load    t13.2    class=medium
load    t13.3    class=medium
connect t13 -> t13.1:0 -> t13.2:0 -> t13.3:0 -> mix
connect t13 -> t13.1:1
connect t13.1:1 -> t13.2:1
connect t13.2:1 -> t13.3:1

noise   t14      seed=14
