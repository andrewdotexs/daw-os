#!/bin/sh
# dawOS boot report: one line with what an automated boot test needs.
#
# Output format (single line, space-separated key=value pairs):
#   DAWOS-BOOT-REPORT version=<v> variant=<v> kernel=<r> realtime=<0|1> secureboot=<0|1> verity=<0|1> rootpart=<label> profile=<name> tune=<ok|off|degraded|none> gpu=<driver|none> firmware=<same|changed|skipped|no-reference|unreadable|none> kvm=<0|1> usb_asap=<on|off|none> timers=<none|names> var=<state|tmpfs|none> failed_units=<n> uptime_s=<s>

set -eu

# IMAGE_VERSION and VARIANT_ID are written by post-build.sh.
# shellcheck source=/dev/null
. /etc/os-release

# Units in "failed" state right now. The report itself is still running,
# so "systemctl is-system-running" would only ever say "starting" here.
failed=$(systemctl list-units --state=failed --no-legend --plain | wc -l)

# 1 when the running kernel is a PREEMPT_RT kernel. The kernel says so in
# its version string. (The /sys/kernel/realtime file known from the
# out-of-tree RT patches does not exist in mainline 6.18.)
case "$(uname -v)" in
*PREEMPT_RT*) realtime=1 ;;
*) realtime=0 ;;
esac

# 1 when the firmware started this system with Secure Boot enforced. The
# UEFI variable holds four bytes of attributes, then one byte: 1 = on.
secureboot=0
sb_var=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
# (The fifth number of the dump: the od of busybox has no -j and -N.)
if [ -r "${sb_var}" ] && [ "$(od -An -tu1 "${sb_var}" | awk 'NR == 1 { print $5 }')" = 1 ]; then
	secureboot=1
fi

# 1 when the root file system is the device-mapper device "dawos-root",
# which the kernel builds from the dm-verity table on its command line,
# and that device reports itself as verified: its status line then reads
# "0 <sectors> verity V" (it would end in "C" after a corrupted block).
verity=0
root_dev=$(mountpoint -d /)
for dm in /sys/block/dm-*; do
	[ -r "${dm}/dev" ] || continue
	[ -r "${dm}/dm/name" ] || continue
	if [ "$(cat "${dm}/dev")" = "${root_dev}" ] && [ "$(cat "${dm}/dm/name")" = dawos-root ]; then
		case "$(dmsetup status dawos-root 2> /dev/null)" in
		*" verity V"*) verity=1 ;;
		esac
	fi
done

# GPT name of the root partition in use, as on the kernel command line:
# it carries the version, so it tells which system image, and therefore
# which slot, is running.
rootpart=$(sed -n 's/.*PARTLABEL=\(dawos-root-[A-Za-z0-9._+-]*\).*/\1/p' /proc/cmdline)
[ -n "${rootpart}" ] ||
	rootpart=$(sed -n 's/.*PARTLABEL=\(dawos-inst-[A-Za-z0-9._+-]*\).*/\1/p' /proc/cmdline)

# Boot profile named on the kernel command line, and what dawos-tune made
# of it: "ok" when the profile is applied in full, "off" for the profile
# "generic", which has nothing to apply, "degraded" when the profile does
# not fit this machine or a step failed, "none" when there is no report.
profile=$(sed -n 's/.*dawos\.profile=\([a-z0-9-]*\).*/\1/p' /proc/cmdline)
tune=$(sed -n 's/^  "status": "\([a-z]*\)".*/\1/p' /run/dawos/topology.json 2> /dev/null)

# Kernel driver that holds the first display controller, "none" when no
# driver does: the screen is then as the firmware left it, which on the
# reference machine costs the live CPUs (step P1.0). The profile "285k"
# loads the driver through dawos-tune.
gpu=none
for device in /sys/bus/pci/devices/*; do
	[ -r "${device}/class" ] || continue
	case "$(cat "${device}/class")" in
	0x03*) ;;
	*) continue ;;
	esac
	[ -L "${device}/driver" ] && gpu=$(basename "$(readlink "${device}/driver")")
	break
done

# What the comparison of the firmware with its reference said at this
# boot (dawos-firmware, run by dawos-tune): "same", "changed", "skipped"
# where there is nothing to compare, "none" when it did not run.
firmware=$(sed -n 's/^status=//p' /run/dawos/firmware.txt 2> /dev/null | head -n 1)

# 1 when the kernel can host a virtual machine on this processor: KVM is
# built into the kernel (ADR 0019), and the device appears only where
# the processor has the hardware support and the firmware allows it.
kvm=0
[ -c /dev/kvm ] && kvm=1

# How the USB audio driver hands its output transfers to the controller
# (ADR 0026): "on" as soon as possible, "off" with the number of their
# frame, "none" when the kernel has no such switch. A profile asks for it
# on the kernel command line; a parameter the kernel does not know is
# dropped without a word, and this is where it would show.
case "$(cat /sys/module/snd_usb_audio/parameters/iso_asap 2> /dev/null)" in
Y) usb_asap=on ;;
N) usb_asap=off ;;
*) usb_asap=none ;;
esac

# Timers that are armed. A workstation that records must not start work
# on its own schedule: the only timer allowed is the daily clean-up of
# temporary files. Anything else is named here, so that a package that
# brings a timer along is noticed by the tests.
timers=$(systemctl list-units --type=timer --state=active --no-legend --plain |
	awk '$1 != "systemd-tmpfiles-clean.timer" { printf "%s%s", sep, $1; sep = "," }')

# Where /var lives: "state" when it is the persistent partition, "tmpfs"
# when it is in memory (installation medium, image without a state
# partition), "none" when nothing is mounted there, which is a fault.
var=none
while read -r _ where fstype _; do
	[ "${where}" = /var ] || continue
	case "${fstype}" in
	tmpfs) var=tmpfs ;;
	*) var=state ;;
	esac
done < /proc/mounts

# Seconds since the kernel started, as a cheap boot-time indicator.
# The authoritative figure is "systemd-analyze", run by hand.
read -r uptime _ < /proc/uptime

report=$(printf 'DAWOS-BOOT-REPORT version=%s variant=%s kernel=%s realtime=%s secureboot=%s verity=%s rootpart=%s profile=%s tune=%s gpu=%s firmware=%s kvm=%s usb_asap=%s timers=%s var=%s failed_units=%s uptime_s=%s' \
	"${IMAGE_VERSION:-unknown}" "${VARIANT_ID:-unknown}" "$(uname -r)" "${realtime}" "${secureboot}" "${verity}" "${rootpart:-unknown}" "${profile:-generic}" "${tune:-none}" "${gpu}" "${firmware:-none}" "${kvm}" "${usb_asap}" "${timers:-none}" "${var}" "${failed}" "${uptime}")
echo "${report}"

# The unit sends the line above to the console. The test harness reads
# the serial port of the virtual machine, which is the console only in the
# profile "generic": under any other profile, in a virtual machine, the
# report is written to the serial port as well. Never on a real machine,
# where the profiles leave the serial port alone on purpose.
case " $(cat /proc/cmdline) " in
*" console=ttyS0"*) ;;
*)
	if [ -w /dev/ttyS0 ] && systemd-detect-virt --quiet --vm 2> /dev/null; then
		echo "${report}" > /dev/ttyS0 2> /dev/null || true
	fi
	;;
esac
