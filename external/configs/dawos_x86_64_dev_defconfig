# dawOS — "dev" variant, x86-64 (Phase 0, steps P0.2 to P0.4)
#
# Option names verified against Buildroot 2026.02.3.
# Regenerate with "make savedefconfig" after "make menuconfig".

# --- Target architecture ----------------------------------------------------
# x86-64-v3 = AVX2 + FMA + BMI2 for the whole userspace (engine decision).
BR2_x86_64=y
BR2_x86_x86_64_v3=y

# --- Toolchain (ADR 0006) ---------------------------------------------------
# Prebuilt Bootlin toolchain, glibc: third-party VST3 binaries need glibc.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_V3_GLIBC_STABLE=y

# --- Build policy -----------------------------------------------------------
# Every download must match a known hash, including the custom kernel
# version (hash kept in external/patches/linux/linux.hash).
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_DAWOS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# --- System -----------------------------------------------------------------
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="dawos"
BR2_TARGET_GENERIC_ISSUE="dawOS (dev)"
# Login prompt on the screen (tty1). systemd adds one on the kernel console
# by itself, which is the serial port (see cmdline/common.txt).
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
# Read-only root: /var is a tmpfs populated from a factory copy until the
# persistent "state" partition arrives in step P0.5.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/post-image.sh"
# Passed to both scripts as their second argument: the image variant.
BR2_ROOTFS_POST_SCRIPT_ARGS="dev"

# --- Kernel (ADR 0007) ------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.63"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/linux/base.fragment $(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/linux/storage.fragment $(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/linux/qemu.fragment $(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/linux/rt.fragment $(BR2_EXTERNAL_DAWOS_PATH)/board/dawos/x86_64/linux/hw-285k.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# --- Packages ---------------------------------------------------------------
BR2_PACKAGE_SYSTEMD_BOOT=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y

# --- Remote access (dev variant only, ADR 0005) -----------------------------
# SSH with public keys only; configuration in the rootfs overlay.
BR2_PACKAGE_OPENSSH=y

# --- Installation on the internal disk (step P0.4) --------------------------
# systemd-repart creates the partition table of document 0, section 3.3;
# the mkfs tools format the ESP and the data partitions.
BR2_PACKAGE_SYSTEMD_REPART=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_XFSPROGS=y
# lsblk, to show what is on a disk before it is erased.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# lspci and lsusb, to record the hardware of the reference machine.
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y

# --- Measurement tools (dev variant only, ADR 0005) -------------------------
# rtla: timerlat, osnoise, hwnoise. Built from the kernel sources.
BR2_PACKAGE_LINUX_TOOLS_RTLA=y
# cpupower: idle-state and frequency inspection; rtla links its library.
BR2_PACKAGE_LINUX_TOOLS_CPUPOWER=y
# cyclictest: independent cross-check of timerlat.
BR2_PACKAGE_RT_TESTS=y
# Load generator for the measurement campaign.
BR2_PACKAGE_STRESS_NG=y
# Records and reads kernel traces when a latency threshold is exceeded.
BR2_PACKAGE_TRACE_CMD=y
# Full ps and top: scheduling class, real-time priority and CPU of every
# thread, which the busybox applets cannot show.
BR2_PACKAGE_PROCPS_NG=y

# --- Filesystem images ------------------------------------------------------
# EROFS root, LZ4HC: fastest decompression, which is what boot time needs.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- Host tools used by post-image.sh ---------------------------------------
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
