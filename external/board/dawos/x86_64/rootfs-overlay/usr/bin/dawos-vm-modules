#!/bin/sh
# dawos-vm-modules — load the kernel modules of the virtual machine host
# and say what came with them (ADR 033).
#
# The kernel has what it takes to host a Linux guest (KVM, the vhost
# back ends, tun, address translation in nftables), all as modules that
# nothing loads at boot. This tool loads them, or removes them, and
# writes down what changed: which modules are in, the kernel threads
# that appeared, whether the kernel is tainted. It starts no virtual
# machine and measures nothing: the noise on the CPUs is measured by
# dawos-hwnoise and dawos-osnoise, before and after.
#
# The report goes to /var/lib/dawos/measure/vmmod-<time>[-LABEL].

set -u

PROG=dawos-vm-modules
BASE=/var/lib/dawos/measure
MODULES="kvm_intel vhost_net vhost_vsock tun nft_nat nft_masq"
# For removal: a module after those that use it, with the ones the
# others pull in and that would stay behind.
REMOVAL="nft_masq nft_nat nf_tables vhost_vsock vhost_net vhost vhost_iotlb tun
	vsock_loopback vmw_vsock_virtio_transport_common vsock kvm_intel kvm irqbypass"

usage() {
	cat <<USAGE
Usage:
  ${PROG} --load [LABEL]   load the modules and write a report
  ${PROG} --unload         remove them
  ${PROG} --status         say which are loaded
USAGE
}

die() {
	echo "${PROG}: $*" >&2
	exit 1
}

is_loaded() {
	[ -d "/sys/module/$1" ]
}

# Names of the kernel threads, one per line. The workers of the work
# queues come and go by themselves and are left out.
kernel_threads() {
	ps -o ppid,comm | awk '$1 == 2 && $2 !~ /^kworker/ { print $2 }' | sort
}

status() {
	for module in ${MODULES}; do
		if is_loaded "${module}"; then echo "${module}: loaded"; else echo "${module}: not loaded"; fi
	done
	if [ -c /dev/kvm ]; then echo "/dev/kvm: present"; else echo "/dev/kvm: absent"; fi
}

action=
label=
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--load | --unload | --status) action=$1 ;;
	-*) die "unknown option '$1' (try --help)" ;;
	*) label=$1 ;;
	esac
	shift
done
[ -n "${action}" ] || {
	usage >&2
	exit 1
}

if [ "${action}" = --status ]; then
	status
	exit 0
fi

[ "$(id -u)" = 0 ] || die "must run as root"
command -v modprobe > /dev/null || die "'modprobe' not found"

if [ "${action}" = --unload ]; then
	failed=no
	for module in ${REMOVAL}; do
		is_loaded "${module}" || continue
		modprobe -r "${module}" 2> /dev/null || {
			echo "${PROG}: could not remove ${module} (in use?)" >&2
			failed=yes
		}
	done
	status
	[ "${failed}" = no ] || exit 1
	exit 0
fi

if [ -n "${label}" ]; then
	echo "${label}" | grep -Eq '^[A-Za-z0-9_-]+$' || die "the label may only contain letters, digits, '-' and '_'"
fi
dir="${BASE}/vmmod-$(date -u +%Y%m%dT%H%M%SZ)${label:+-${label}}"
mkdir -p "${dir}" || die "could not create ${dir}"

kernel_threads > "${dir}/threads-before.txt"
lsmod | awk 'NR > 1 { print $1 }' | sort > "${dir}/modules-before.txt"
read -r loaded_at _ < /proc/uptime
problems=
: > "${dir}/modprobe.txt"
for module in ${MODULES}; do
	if modprobe "${module}" >> "${dir}/modprobe.txt" 2>&1; then
		echo "${module}: loaded" >> "${dir}/modprobe.txt"
	else
		echo "${module}: FAILED" >> "${dir}/modprobe.txt"
		problems="${problems:+${problems}, }${module} did not load"
	fi
done
sleep 2
kernel_threads > "${dir}/threads-after.txt"
lsmod | awk 'NR > 1 { print $1 }' | sort > "${dir}/modules-after.txt"
[ -c /dev/kvm ] || problems="${problems:+${problems}, }no /dev/kvm"

{
	date -u '+utc: %Y-%m-%dT%H:%M:%SZ'
	echo "label: ${label:-none}"
	echo "loaded_at_uptime_s: ${loaded_at}"
	echo "kernel: $(uname -srv)"
	echo "image: $(sed -n 's/^BUILD_ID=//p' /etc/os-release)"
	echo "profile: $(sed -n 's/.*dawos\.profile=\([a-z0-9-]*\).*/\1/p' /proc/cmdline)"
	echo "processor_has_vmx: $(if grep -qw vmx /proc/cpuinfo; then echo yes; else echo no; fi)"
	echo "modules_added: $(grep -vxF -f "${dir}/modules-before.txt" "${dir}/modules-after.txt" | tr '\n' ' ')"
	echo "kernel_threads_added: $(grep -vxF -f "${dir}/threads-before.txt" "${dir}/threads-after.txt" | sort | uniq -c | awk '{ printf "%s (%d) ", $2, $1 }')"
	echo "kvm_enables_virtualization_at_load: $(cat /sys/module/kvm/parameters/enable_virt_at_load 2> /dev/null || echo unknown)"
	echo "kernel_tainted: $(cat /proc/sys/kernel/tainted)"
	status
	echo "problems: ${problems:-none}"
	echo "--- modprobe:"
	cat "${dir}/modprobe.txt"
	echo "--- kernel log since loading:"
	journalctl -k -b --no-pager -o short-monotonic 2> /dev/null |
		awk -v since="${loaded_at}" '{ stamp = $0; sub(/^\[ */, "", stamp); if (stamp + 0 >= since - 1) print }' | tail -n 30
} > "${dir}/report.txt"
cat "${dir}/report.txt"
[ -z "${problems}" ] || exit 1
