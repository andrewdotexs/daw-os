# Sixteen tracks side by side, each a source and three instances of the
# reference load of requirement R-04 one after the other (ADR 0011: of
# ten instances six are light, three medium, one heavy), all meeting on
# one bus with a meter.
#
# It is the shape the acceptance of step P1.7 needs: the same graph on
# one, two, three and four live threads. The tracks do not wait for each
# other, so the work can be shared; inside a track every instance waits
# for the one before, and that chain is the least a cycle can last.

noise   t1      seed=1
load    t1.1     class=light
load    t1.2     class=light
load    t1.3     class=light
connect t1 -> t1.1:0 -> t1.2:0 -> t1.3:0 -> mix
connect t1 -> t1.1:1
connect t1.1:1 -> t1.2:1
connect t1.2:1 -> t1.3:1

noise   t2      seed=2
load    t2.1     class=light
load    t2.2     class=light
load    t2.3     class=light
connect t2 -> t2.1:0 -> t2.2:0 -> t2.3:0 -> mix
connect t2 -> t2.1:1
connect t2.1:1 -> t2.2:1
connect t2.2:1 -> t2.3:1

noise   t3      seed=3
load    t3.1     class=medium
load    t3.2     class=medium
load    t3.3     class=medium
connect t3 -> t3.1:0 -> t3.2:0 -> t3.3:0 -> mix
connect t3 -> t3.1:1
connect t3.1:1 -> t3.2:1
connect t3.2:1 -> t3.3:1

noise   t4      seed=4
load    t4.1     class=heavy
load    t4.2     class=light
load    t4.3     class=light
connect t4 -> t4.1:0 -> t4.2:0 -> t4.3:0 -> mix
connect t4 -> t4.1:1
connect t4.1:1 -> t4.2:1
connect t4.2:1 -> t4.3:1

noise   t5      seed=5
load    t5.1     class=light
load    t5.2     class=light
load    t5.3     class=light
