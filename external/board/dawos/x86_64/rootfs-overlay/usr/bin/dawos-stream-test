#!/bin/sh
# dawos-stream-test — can a project that lives inside an encrypted home
# feed the audio engine? (experiment E-05, ADR 0004)
#
# The home of a user will be an XFS file system inside a LUKS2 image,
# attached through a loop device, the image being a file on the "homes"
# partition: what systemd-homed does. Streaming a project then crosses
# XFS, dm-crypt, the loop device and XFS again before it reaches the
# disk. This tool measures what that costs, next to two references, all
# on the same disk:
#
#   s    XFS on the "shared" partition, in the clear: the reference.
#   p    XFS on LUKS2 directly on the "homes" partition: the fallback (a
#        LUKS partition per user), and the cost of encryption alone.
#   pn   the same, with the two dm-crypt options that keep encryption
#        out of the kernel work queues.
#   l    XFS on LUKS2 on a loop device with direct I/O, the image being
#        a file on XFS in "homes": today's choice.
#   ln   the same, with the two dm-crypt options.
#
# and three loads, with fio (io_uring, O_DIRECT), run from the CPUs of
# the "io" domain, where the streaming threads of the engine will live:
#
#   w1   sequential read, blocks of 1 MiB, depth 32: refilling the
#        buffers after the play cursor has moved.
#   w2   16 read streams of 256 KiB blocks, 400 MB/s in all, with 16
#        sequential writes to preallocated files, 6 MB/s in all: the
#        192 kHz session playing, with 16 tracks recording. While it
#        runs, rtla timerlat measures the live CPUs and the use of every
#        domain is taken from /proc/stat.
#   w3   appends of 4 KiB, each followed by fdatasync: the journal of
#        the project.
#
# "p" and "pn" ERASE the "homes" partition: they need --erase-homes, and
# the partition must hold an empty XFS file system (as after
# installation). It is given a new, empty XFS afterwards, with the same
# label and identifier. "l" and "ln" only create a file in it. "s"
# works in a directory of its own in "shared" and removes it.
#
# The measurement runs as a transient unit: it goes on if the SSH
# session ends. Results go to /var/lib/dawos/measure/stream-<time>[-LABEL];
# fetch them with "make measure-fetch".

set -u

PROG=dawos-stream-test
SELF=/usr/bin/dawos-stream-test
UNIT=dawos-stream-test
BASE=/var/lib/dawos/measure
RUN=/run/dawos-stream
# What "homes" was before it was erased: kept out of the results, and
# on disk, so that it survives a power cut.
SAVED=/var/lib/dawos/stream-test-homes
CPU_DIR=/sys/devices/system/cpu
ALL_CONFIGS="s p pn l ln"
SUBDIR=dawos-stream-test
LUKS_LABEL=dawos-stream-test
STREAMS=16
# Bytes per second of each stream: 400 MB/s and 6 MB/s over 16 streams.
PLAY_RATE=25000000
# fio replaces $jobnum itself with the number of each job: the streams
# read the files 0 to 15 and write the files 16 to 31.
READ_FILES="read-\$jobnum.dat"
WRITE_FILES="write-\$jobnum.dat"
RECORD_RATE=375000

# Thresholds fixed on 13 November 2026 (change log, experiment E-05).
MIN_W1_GBS=1.2
MAX_W2_P999_MS=20
MAX_W2_MS=200
MAX_W2_IO_PCT=50
MAX_W3_P99_MS=10
MAX_TIMERLAT_US=20
MIN_W1_RELATIVE=0.70
MAX_LATENCY_RELATIVE=2
MAX_TIMERLAT_WORSENING_US=5

usage() {
	cat <<USAGE
Usage:
  ${PROG} [--configs "LIST"] [--erase-homes] [--quick] [LABEL]
                              start the measurement (about 70 minutes for
                              all five configurations)
  ${PROG} --status            say whether it runs, show the last summary
  ${PROG} --summary DIR       (re)compute the summary of a run
  ${PROG} --restore-homes     after a power cut during "p": give "homes"
                              its empty XFS back

  --configs "LIST"   among: ${ALL_CONFIGS} (default: all)
  --erase-homes      needed by p and pn, which erase the "homes" partition
  --quick            small files and a few seconds per load: a trial of
                     the tool, whose figures mean nothing
  --shared-dev DEV, --homes-dev DEV
                     other block devices in place of the two partitions
USAGE
}

die() {
	echo "${PROG}: $*" >&2
	exit 1
}

# CPUs of a kernel list ("4-7", "0-3,8-15"), one per line, sorted.
expand_list() {
	echo "$1" | tr ',' '\n' | while IFS=- read -r first last; do
		case "${first}" in
		'' | *[!0-9]*) continue ;;
		esac
		seq "${first}" "${last:-${first}}"
	done | sort -n -u
}

uptime_now() {
	read -r uptime_value _ < /proc/uptime
	echo "${uptime_value}"
}

# A domain of the report of dawos-tune ("io", "system", ...), or nothing.
domain_cpus() {
	sed -n "s/^    \"$1\": \"\\(.*\\)\".*/\\1/p" /run/dawos/topology.json 2> /dev/null
}

# The JSON report of fio as "path value" lines, one per number or
# string: jobs.0.read.clat_ns.percentile.99.900000 1234. fio writes one
# key per line, which is all this relies on.
flatten() {
	awk '
		function path(    i, text) {
			text = ""
			# The first level is the report itself and has no name.
			for (i = 2; i <= depth; i++) text = text (i > 2 ? "." : "") name[i]
			return text
		}
		{
			line = $0
			sub(/^[ \t]+/, "", line)
			sub(/,[ \t]*$/, "", line)
			key = ""
			if (line ~ /^"/) {
				key = line
				sub(/^"/, "", key)
				sub(/".*/, "", key)
				gsub(/ /, "_", key)
				sub(/^"[^"]*"[ \t]*:[ \t]*/, "", line)
			}
			if (line == "{" || line == "[") {
				if (key == "") key = index_at[depth]++
				name[++depth] = key
				index_at[depth] = 0
				next
			}
			if (line ~ /^[]}]/) { depth--; next }
			if (key == "") next
			gsub(/"/, "", line)
			print path() "." key, line
		}' "$1"
}

# One value of a flattened report: $1 file, $2 path. 0 if absent.
value_of() {
	awk -v wanted="$2" '$1 == wanted { print $2; found = 1; exit } END { if (!found) print 0 }' "$1"
}

# Write summary.txt of the directory $1.
summarize() {
	result=$1
	[ -r "${result}/meta.txt" ] || die "${result} holds no measurement"
	{
		echo "directory: ${result}"
		cat "${result}/meta.txt"
		echo
		printf '%-7s %-8s %-10s %-10s %-10s %-9s %-13s %-13s %-9s %-9s\n' config w1_gb_s w2_p999_ms w2_max_ms w3_p99_ms w3_per_s w2_read_mb_s w2_write_mb_s w2_io_pct timerlat
		for config in ${ALL_CONFIGS}; do
			[ -r "${result}/fio-${config}-w1.txt" ] || continue
			w1=$(value_of "${result}/fio-${config}-w1.txt" jobs.0.read.bw_bytes)
			read_p=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.read.clat_ns.percentile.99.900000)
			write_p=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.write.clat_ns.percentile.99.900000)
			read_max=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.read.clat_ns.max)
			write_max=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.write.clat_ns.max)
			read_bw=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.read.bw_bytes)
			write_bw=$(value_of "${result}/fio-${config}-w2.txt" jobs.0.write.bw_bytes)
			sync_p=$(value_of "${result}/fio-${config}-w3.txt" jobs.0.sync.lat_ns.percentile.99.000000)
			sync_iops=$(value_of "${result}/fio-${config}-w3.txt" jobs.0.write.iops)
			io_pct=$(awk '$1 == "io" { print $2 }' "${result}/cpu-${config}-w2.txt" 2> /dev/null)
			timerlat=$(awk '{ print $3 }' "${result}/timerlat-${config}.max" 2> /dev/null)
			echo "${config} ${w1} ${read_p} ${write_p} ${read_max} ${write_max} ${sync_p} ${sync_iops} ${read_bw} ${write_bw} ${io_pct:--} ${timerlat:--}" |
				awk '{
					p999 = ($3 > $4 ? $3 : $4) / 1000000
					worst = ($5 > $6 ? $5 : $6) / 1000000
					printf "%-7s %-8.2f %-10.2f %-10.1f %-10.3f %-9d %-13.1f %-13.2f %-9s %-9s\n", $1, $2 / 1000000000, p999, worst, $7 / 1000000, $8, $9 / 1000000, $10 / 1000000, $11, $12
				}'
		done > "${result}/table.txt"
		cat "${result}/table.txt"
		echo "w1_gb_s: sequential read; w2_p999_ms and w2_max_ms: completion latency of the streaming load, the worse of reads and writes; w3_p99_ms: fdatasync after a 4 KiB append; w2_io_pct: use of the io domain during w2; timerlat: longest wake-up delay of a user thread on the live CPUs during w2, in us"
		echo
		echo "use of each domain during w2, percent (io, then the others):"
		for config in ${ALL_CONFIGS}; do
			[ -r "${result}/cpu-${config}-w2.txt" ] || continue
			echo "  ${config}: $(tr '\n' ' ' < "${result}/cpu-${config}-w2.txt")"
		done
		echo
		if grep -q '^mode: quick' "${result}/meta.txt"; then
			echo "quick run: a trial of the tool. The figures mean nothing and are not compared with the thresholds."
		else
			# Each configuration against the fixed limits, then l
			# against p and ln against pn.
			awk -v w1="${MIN_W1_GBS}" -v p999="${MAX_W2_P999_MS}" -v worst="${MAX_W2_MS}" -v io="${MAX_W2_IO_PCT}" \
				-v sync="${MAX_W3_P99_MS}" -v timer="${MAX_TIMERLAT_US}" -v share="${MIN_W1_RELATIVE}" \
				-v times="${MAX_LATENCY_RELATIVE}" -v worsening="${MAX_TIMERLAT_WORSENING_US}" '
				function check(failed, text) { if (failed) why = why (why == "" ? "" : "; ") text }
				{
					seen[$1] = 1
					W1[$1] = $2; P999[$1] = $3; MAX[$1] = $4; SYNC[$1] = $5; IO[$1] = $9; TIMER[$1] = $10
					why = ""
					check($2 < w1, sprintf("w1 %.2f GB/s, under %.1f", $2, w1))
					check($3 > p999, sprintf("w2 99.9th percentile %.2f ms, over %d", $3, p999))
					check($4 > worst, sprintf("w2 longest %.1f ms, over %d", $4, worst))
					check($9 != "-" && $9 > io, sprintf("io domain at %s %%, over %d", $9, io))
					check($5 > sync, sprintf("w3 fdatasync %.3f ms, over %d", $5, sync))
					check($10 != "-" && $10 > timer, sprintf("timerlat %s us, over %d", $10, timer))
					printf "limits %s: %s\n", $1, (why == "" ? "PASS" : "FAIL (" why ")")
				}
				function compare(loop, part) {
					if (!seen[loop] || !seen[part]) return
					why = ""
					check(W1[loop] < share * W1[part], sprintf("w1 at %.0f %% of %s, under %d %%", 100 * W1[loop] / W1[part], part, 100 * share))
					check(P999[loop] > times * P999[part], sprintf("w2 99.9th percentile %.1f times that of %s", P999[loop] / P999[part], part))
					check(SYNC[loop] > times * SYNC[part], sprintf("w3 fdatasync %.1f times that of %s", SYNC[loop] / SYNC[part], part))
					check(TIMER[loop] != "-" && TIMER[part] != "-" && TIMER[loop] - TIMER[part] > worsening, sprintf("timerlat %.1f us worse than %s", TIMER[loop] - TIMER[part], part))
					printf "against %s, %s: %s\n", part, loop, (why == "" ? "PASS" : "FAIL (" why ")")
				}
				END { compare("l", "p"); compare("ln", "pn") }' "${result}/table.txt"
			echo "limits: w1 at least ${MIN_W1_GBS} GB/s; w2 99.9th percentile at most ${MAX_W2_P999_MS} ms, longest at most ${MAX_W2_MS} ms, io domain at most ${MAX_W2_IO_PCT} %; w3 fdatasync 99th percentile at most ${MAX_W3_P99_MS} ms; timerlat at most ${MAX_TIMERLAT_US} us"
			echo "against the partition: w1 at least 70 %; w2 99.9th percentile and w3 fdatasync at most twice; timerlat at most ${MAX_TIMERLAT_WORSENING_US} us worse"
		fi
		grep -h '^note: ' "${result}/steps.txt" 2> /dev/null
	} > "${result}/summary.txt"
	cat "${result}/summary.txt"
}

# ---------------------------------------------------------------------------
# What follows runs inside the unit.

# Everything this tool may have left behind, in the order that undoes it.
release() {
	for mount_point in "${RUN}/mnt" "${RUN}/outer"; do
		if grep -q " ${mount_point} " /proc/mounts; then
			umount "${mount_point}" 2> /dev/null || umount -l "${mount_point}" 2> /dev/null
		fi
	done
	for mapping in "${UNIT}-p" "${UNIT}-l"; do
		[ -e "/dev/mapper/${mapping}" ] && cryptsetup close "${mapping}" 2> /dev/null
	done
	if [ -r "${RUN}/loop" ]; then
		losetup -d "$(cat "${RUN}/loop")" 2> /dev/null
		rm -f "${RUN}/loop"
	fi
}

# Give "homes" an empty XFS again, with the label and the identifier it
# had. The device, the label and the identifier come from the note left
# before erasing; the device is only touched if what it holds is the
# LUKS header written by this tool, and the note is only removed once
# the device holds XFS again.
restore_homes() {
	[ -r "${SAVED}" ] || return 0
	device=$(sed -n 's/^device=//p' "${SAVED}")
	[ -b "${device}" ] || return 1
	if [ "$(blkid -p -s LABEL -o value "${device}" 2> /dev/null)" = "${LUKS_LABEL}" ]; then
		label=$(sed -n 's/^label=//p' "${SAVED}")
		uuid=$(sed -n 's/^uuid=//p' "${SAVED}")
		# The LUKS2 header and its copy lie within the first megabytes:
		# cleared first, so that nothing can take the device for an
		# encrypted one afterwards.
		dd if=/dev/zero of="${device}" bs=1M count=32 2> /dev/null &&
			mkfs.xfs -q -f -L "${label:-homes}" ${uuid:+-m "uuid=${uuid}"} "${device}" || return 1
	fi
	[ "$(blkid -p -s TYPE -o value "${device}" 2> /dev/null)" = xfs ] || return 1
	rm -f "${SAVED}"
}

# Use of every domain between two copies of /proc/stat: "name percent".
domain_use() {
	for name in io system preemptive live; do
		list=$(domain_cpus "${name}")
		[ -n "${list}" ] || continue
		wanted=$(expand_list "${list}" | tr '\n' ' ')
		awk -v wanted="${wanted}" -v name="${name}" '
			BEGIN { count = split(wanted, cpu, " "); for (i = 1; i <= count; i++) member["cpu" cpu[i]] = 1 }
			!($1 in member) { next }
			{
				total = 0
				for (i = 2; i <= 9; i++) total += $i
				sign = (FILENAME == ARGV[1]) ? -1 : 1
				all += sign * total
				idle += sign * ($5 + $6)
			}
			END { if (all > 0) printf "%s %.1f\n", name, 100 * (all - idle) / all }' "$1" "$2"
	done
}

# fio on the CPUs of the io domain; standard output is its JSON report.
run_fio() {
	if [ -n "${io_cpus}" ]; then
		taskset -c "${io_cpus}" fio --output-format=json "$@"
	else
		fio --output-format=json "$@"
	fi
}

# Write the files the loads read, on the file system mounted at $1.
lay_out() {
	run_fio --name=global --ioengine=io_uring --direct=1 --directory="$1" --rw=write --bs=1M --iodepth=8 --end_fsync=1 \
		--name=play --numjobs="${STREAMS}" --filename_format="${READ_FILES}" --size="${stream_bytes}" \
		--name=fill --filename=seq.dat --size="${seq_bytes}" > "${dir}/layout.json" 2> "${dir}/layout.err" ||
		echo "note: writing the test files failed: $(head -n 2 "${dir}/layout.err" | tr '\n' ' ')" >> "${dir}/steps.txt"
}

# The three loads on the file system mounted at $2, as configuration $1.
run_loads() {
	config=$1
	mnt=$2
	common="--ioengine=io_uring --direct=1 --group_reporting --percentile_list=50:99:99.9"

	# shellcheck disable=SC2086
	run_fio --name=global ${common} --directory="${mnt}" \
		--name=fill --filename=seq.dat --size="${seq_bytes}" --rw=read --bs=1M --iodepth=32 \
		--time_based --runtime="${w1_s}" > "${dir}/fio-${config}-w1.json" 2> "${dir}/fio-${config}-w1.err" ||
		echo "note: ${config} w1: fio failed" >> "${dir}/steps.txt"
	flatten "${dir}/fio-${config}-w1.json" > "${dir}/fio-${config}-w1.txt"
	echo "${config} w1 $(uptime_now)" >> "${dir}/steps.txt"
	sleep 3

	rtla_pid=
	if [ -n "${live_cpus}" ] && command -v rtla > /dev/null; then
		rtla timerlat hist -c "${live_cpus}" -p 1000 -d "$((w2_s - 12))s" -n -b 500 -E 200 --warm-up 5 --no-aa \
			> "${dir}/timerlat-${config}.txt" 2>&1 &
		rtla_pid=$!
	fi
	cat /proc/stat > "${RUN}/stat-before"
	# shellcheck disable=SC2086
	run_fio --name=global ${common} --directory="${mnt}" --time_based --runtime="${w2_s}" \
		--name=play --rw=read --bs=256k --numjobs="${STREAMS}" --filename_format="${READ_FILES}" \
		--size="${stream_bytes}" --rate="${PLAY_RATE}" \
		--name=record --rw=write --bs=64k --numjobs="${STREAMS}" --filename_format="${WRITE_FILES}" \
		--size="${record_bytes}" --rate="${RECORD_RATE}" --fallocate=native \
		> "${dir}/fio-${config}-w2.json" 2> "${dir}/fio-${config}-w2.err" ||
		echo "note: ${config} w2: fio failed" >> "${dir}/steps.txt"
	cat /proc/stat > "${RUN}/stat-after"
	domain_use "${RUN}/stat-before" "${RUN}/stat-after" > "${dir}/cpu-${config}-w2.txt"
	flatten "${dir}/fio-${config}-w2.json" > "${dir}/fio-${config}-w2.txt"
	if [ -n "${rtla_pid}" ]; then
		wait "${rtla_pid}" || echo "note: ${config} w2: rtla ended with an error" >> "${dir}/steps.txt"
		# Longest delay per kind of column (IRQ, Thr, Usr), in us, from
		# the row "max:" of the per-CPU part of the histogram.
		awk '
			/^ALL:/ { exit }
			$1 == "Index" { for (i = 2; i <= NF; i++) kind[i] = substr($i, 1, 3); next }
			$1 == "max:" { for (i = 2; i <= NF; i++) if ($i != "-" && $i + 0 > high[kind[i]]) high[kind[i]] = $i + 0 }
			END { printf "%.2f %.2f %.2f\n", high["IRQ"] / 1000, high["Thr"] / 1000, high["Usr"] / 1000 }' \
			"${dir}/timerlat-${config}.txt" > "${dir}/timerlat-${config}.max"
	fi
	echo "${config} w2 $(uptime_now)" >> "${dir}/steps.txt"
	sleep 3

	rm -f "${mnt}/journal.dat"
	# shellcheck disable=SC2086
	run_fio --name=global ${common} --directory="${mnt}" \
		--name=journal --filename=journal.dat --rw=write --bs=4k --fdatasync=1 --fallocate=none \
		--size="${journal_bytes}" --runtime="${w3_s}" > "${dir}/fio-${config}-w3.json" 2> "${dir}/fio-${config}-w3.err" ||
		echo "note: ${config} w3: fio failed" >> "${dir}/steps.txt"
	flatten "${dir}/fio-${config}-w3.json" > "${dir}/fio-${config}-w3.txt"
	rm -f "${mnt}/journal.dat"
	echo "${config} w3 $(uptime_now)" >> "${dir}/steps.txt"
	sleep 3
}

# The encrypted configurations of one device: format it, then, for each
# configuration asked for, open it with its options and run the loads.
# $1 device, $2 name of the mapping, then the configurations.
run_encrypted() {
	device=$1
	mapping=$2
	shift 2
	cryptsetup luksFormat --batch-mode --type luks2 --cipher aes-xts-plain64 --key-size 512 \
		--pbkdf pbkdf2 --pbkdf-force-iterations 1000 --label "${LUKS_LABEL}" --key-file "${RUN}/key" "${device}" ||
		{
			echo "note: could not format ${mapping} as LUKS2" >> "${dir}/steps.txt"
			return 1
		}
	cryptsetup luksDump "${device}" | grep -E '^Version|cipher:|sector:|^Label' | tr -s ' \t' ' ' > "${dir}/luks-${mapping##*-}.txt"
	first=yes
	for config in "$@"; do
		options=
		case "${config}" in
		*n) options="--perf-no_read_workqueue --perf-no_write_workqueue" ;;
		esac
		# shellcheck disable=SC2086
		cryptsetup open --key-file "${RUN}/key" ${options} "${device}" "${mapping}" || {
			echo "note: ${config}: could not open the encrypted device" >> "${dir}/steps.txt"
			return 1
		}
		# The table without its fifth field, which is the key.
		dmsetup table "${mapping}" | cut -d ' ' -f 1-4,6- > "${dir}/dm-${config}.txt"
		[ "${first}" = no ] || mkfs.xfs -q -f -K "/dev/mapper/${mapping}" ||
			echo "note: ${config}: mkfs.xfs failed" >> "${dir}/steps.txt"
		if mount "/dev/mapper/${mapping}" "${RUN}/mnt"; then
			[ "${first}" = no ] || lay_out "${RUN}/mnt"
			run_loads "${config}" "${RUN}/mnt"
			umount "${RUN}/mnt"
		else
			echo "note: ${config}: could not mount the encrypted file system" >> "${dir}/steps.txt"
		fi
		cryptsetup close "${mapping}"
		first=no
	done
}

run_measurement() {
	dir=$1
	configs=$2
	shared_dev=$3
	homes_dev=$4
	mode=$5
	if [ "${mode}" = quick ]; then
		seq_bytes=32M stream_bytes=4M record_bytes=1M journal_bytes=16M image_bytes=440M
		w1_s=4 w2_s=20 w3_s=4
	else
		seq_bytes=8G stream_bytes=1G record_bytes=256M journal_bytes=24G image_bytes=64G
		w1_s=60 w2_s=600 w3_s=120
	fi
	io_cpus=$(domain_cpus io)
	live_cpus=$(grep -v null "${CPU_DIR}/isolated" 2> /dev/null)
	: > "${dir}/steps.txt"
	mkdir -p "${RUN}/mnt" "${RUN}/outer"
	trap 'release; restore_homes; rm -f "${RUN}/key"' EXIT
	trap 'exit 1' INT TERM HUP
	(umask 077 && dd if=/dev/urandom of="${RUN}/key" bs=64 count=1 2> /dev/null)

	for config in ${configs}; do
		case "${config}" in
		s)
			if mount "${shared_dev}" "${RUN}/mnt"; then
				rm -rf "${RUN:?}/mnt/${SUBDIR:?}"
				mkdir "${RUN}/mnt/${SUBDIR}"
				lay_out "${RUN}/mnt/${SUBDIR}"
				run_loads s "${RUN}/mnt/${SUBDIR}"
				rm -rf "${RUN:?}/mnt/${SUBDIR:?}"
				umount "${RUN}/mnt"
			else
				echo "note: s: could not mount ${shared_dev}" >> "${dir}/steps.txt"
			fi
			;;
		esac
	done

	wanted=$(for config in ${configs}; do case "${config}" in p | pn) echo "${config}" ;; esac; done | tr '\n' ' ')
	if [ -n "${wanted}" ]; then
		{
			echo "device=${homes_dev}"
			echo "label=$(blkid -p -s LABEL -o value "${homes_dev}")"
			echo "uuid=$(blkid -p -s UUID -o value "${homes_dev}")"
		} > "${SAVED}"
		sync
		# shellcheck disable=SC2086
		run_encrypted "${homes_dev}" "${UNIT}-p" ${wanted}
		release
		restore_homes || echo "note: could not give ${homes_dev} its XFS back: run ${PROG} --restore-homes" >> "${dir}/steps.txt"
	fi

	wanted=$(for config in ${configs}; do case "${config}" in l | ln) echo "${config}" ;; esac; done | tr '\n' ' ')
	if [ -n "${wanted}" ]; then
		if mount "${homes_dev}" "${RUN}/outer"; then
			rm -f "${RUN}/outer/${SUBDIR}.img"
			if fallocate -l "${image_bytes}" "${RUN}/outer/${SUBDIR}.img" &&
				losetup --find --show --direct-io=on "${RUN}/outer/${SUBDIR}.img" > "${RUN}/loop"; then
				loop=$(cat "${RUN}/loop")
				echo "direct_io: $(cat "/sys/block/${loop#/dev/}/loop/dio" 2> /dev/null)" > "${dir}/loop.txt"
				# shellcheck disable=SC2086
				run_encrypted "${loop}" "${UNIT}-l" ${wanted}
			else
				echo "note: l: could not create or attach the image file" >> "${dir}/steps.txt"
			fi
			release
			if mount "${homes_dev}" "${RUN}/outer"; then
				rm -f "${RUN}/outer/${SUBDIR}.img"
				umount "${RUN}/outer"
			fi
		else
			echo "note: l: could not mount ${homes_dev}" >> "${dir}/steps.txt"
		fi
	fi
	date -u '+finished_utc: %Y-%m-%dT%H:%M:%SZ' >> "${dir}/meta.txt"
	summarize "${dir}" > /dev/null
}

# ---------------------------------------------------------------------------

configs=${ALL_CONFIGS}
erase=no
mode=full
label=
shared_dev=/dev/disk/by-partlabel/shared
homes_dev=/dev/disk/by-partlabel/homes
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--status)
		if systemctl is-active --quiet "${UNIT}"; then
			echo "A measurement is running:"
			systemctl show -p ActiveEnterTimestamp --value "${UNIT}" | sed 's/^/  started: /'
		else
			echo "No measurement is running."
		fi
		latest=
		for candidate in "${BASE}"/stream-*; do
			[ -d "${candidate}" ] && latest=${candidate}
		done
		if [ -n "${latest}" ]; then
			echo "Latest result directory: ${latest}"
			if [ -r "${latest}/summary.txt" ]; then
				cat "${latest}/summary.txt"
			else
				sed 's/^/  /' "${latest}/meta.txt"
				[ -s "${latest}/steps.txt" ] && sed 's/^/  done: /' "${latest}/steps.txt"
			fi
		fi
		exit 0
		;;
	--summary)
		[ -d "${2:-}" ] || die "--summary needs a result directory"
		summarize "$2"
		exit 0
		;;
	--run)
		shift
		run_measurement "$@"
		exit 0
		;;
	--restore-homes)
		[ "$(id -u)" = 0 ] || die "must run as root"
		systemctl is-active --quiet "${UNIT}" && die "a measurement is running"
		[ -r "${SAVED}" ] || die "nothing to restore: ${SAVED} is not there"
		release
		restore_homes || die "could not give $(sed -n 's/^device=//p' "${SAVED}") its XFS back: look at it with blkid"
		echo "${PROG}: done"
		exit 0
		;;
	--configs)
		configs=${2:-}
		shift
		;;
	--erase-homes) erase=yes ;;
	--quick) mode=quick ;;
	--shared-dev)
		shared_dev=${2:-}
		shift
		;;
	--homes-dev)
		homes_dev=${2:-}
		shift
		;;
	-*) die "unknown option '$1' (try --help)" ;;
	*) label=$1 ;;
	esac
	shift
done

[ "$(id -u)" = 0 ] || die "must run as root"
if [ -n "${label}" ]; then
	echo "${label}" | grep -Eq '^[A-Za-z0-9_-]+$' || die "the label may only contain letters, digits, '-' and '_'"
fi
[ -n "${configs}" ] || die "no configuration given"
needs_shared=no
needs_homes=no
erases=no
for config in ${configs}; do
	case "${config}" in
	s) needs_shared=yes ;;
	p | pn) needs_homes=yes erases=yes ;;
	l | ln) needs_homes=yes ;;
	*) die "unknown configuration '${config}': choose among ${ALL_CONFIGS}" ;;
	esac
done
for tool in fio cryptsetup losetup mkfs.xfs blkid fallocate taskset systemd-run; do
	command -v "${tool}" > /dev/null || die "'${tool}' not found: this needs the dev variant of the image"
done
losetup --version 2> /dev/null | grep -q util-linux || die "this needs the losetup of util-linux (direct I/O)"
systemctl is-active --quiet "${UNIT}" && die "a measurement is already running (${PROG} --status)"
for other in dawos-osnoise dawos-hwnoise dawos-wakeup dawos-freq-sweep dawos-thermal-sweep; do
	systemctl is-active --quiet "${other}" && die "'${other}' is running: wait for it, or stop it"
done
[ ! -r "${SAVED}" ] || die "an earlier run left \"homes\" erased: run ${PROG} --restore-homes first"

# The devices: they must exist, be unused, and hold what is expected.
check_device() {
	[ -b "$1" ] || die "$1 is not a block device"
	device=$(readlink -f "$1")
	grep -q "^${device} " /proc/mounts && die "${device} is mounted"
	[ "$(blkid -p -s TYPE -o value "${device}")" = xfs ] || die "${device} does not hold an XFS file system"
	echo "${device}"
}
if [ "${needs_shared}" = yes ]; then
	shared_dev=$(check_device "${shared_dev}") || exit 1
fi
if [ "${needs_homes}" = yes ]; then
	homes_dev=$(check_device "${homes_dev}") || exit 1
fi
if [ "${erases}" = yes ]; then
	[ "${erase}" = yes ] ||
		die "the configurations p and pn erase ${homes_dev}: add --erase-homes, or leave them out with --configs"
	# Only an empty file system is ever erased.
	mkdir -p "${RUN}/check"
	mount -o ro "${homes_dev}" "${RUN}/check" || die "could not mount ${homes_dev} to look inside"
	content=$(find "${RUN}/check" -mindepth 1 -maxdepth 1 | head -n 3 | tr '\n' ' ')
	umount "${RUN}/check"
	[ -z "${content}" ] || die "${homes_dev} is not empty (${content}): this tool only erases an empty file system"
fi

dir="${BASE}/stream-$(date -u +%Y%m%dT%H%M%SZ)${label:+-${label}}"
mkdir -p "${dir}" || die "could not create ${dir}"
{
	date -u '+started_utc: %Y-%m-%dT%H:%M:%SZ'
	echo "label: ${label:-none}"
	echo "configs: ${configs}"
	echo "mode: ${mode}"
	echo "shared: ${shared_dev} ($(lsblk -n -d -o SIZE "${shared_dev}" 2> /dev/null | tr -d ' '))"
	echo "homes: ${homes_dev} ($(lsblk -n -d -o SIZE "${homes_dev}" 2> /dev/null | tr -d ' '))"
	echo "io_cpus: $(domain_cpus io)"
	echo "live_cpus: $(grep -v null "${CPU_DIR}/isolated" 2> /dev/null)"
	echo "profile: $(sed -n 's/.*dawos\.profile=\([a-z0-9-]*\).*/\1/p' /proc/cmdline)"
	echo "tune: $(sed -n 's/^  "status": "\([a-z]*\)".*/\1/p' /run/dawos/topology.json 2> /dev/null)"
	echo "kernel: $(uname -srv)"
	echo "bios: $(cat /sys/class/dmi/id/bios_version 2> /dev/null) $(cat /sys/class/dmi/id/bios_date 2> /dev/null)"
	echo "image: $(sed -n 's/^BUILD_ID=//p' /etc/os-release)"
	echo "fio: $(fio --version)"
	echo "cryptsetup: $(cryptsetup --version | cut -d ' ' -f 1-2)"
	echo "uptime_at_start_s: $(uptime_now | cut -d . -f 1)"
} > "${dir}/meta.txt"

systemd-run --quiet --unit="${UNIT}" --collect \
	--description="dawOS streaming measurement (experiment E-05)" \
	/bin/sh "${SELF}" --run "${dir}" "${configs}" "${shared_dev}" "${homes_dev}" "${mode}" ||
	die "could not start the measurement"

count=$(echo "${configs}" | wc -w)
if [ "${mode}" = quick ]; then
	echo "Trial started: ${count} configurations, about a minute each; results in ${dir}"
else
	echo "Measurement started: ${count} configurations, about 14 minutes each; results in ${dir}"
fi
echo "Follow it with: ${PROG} --status"
