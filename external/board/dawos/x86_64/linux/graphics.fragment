# Graphics driver of the integrated GPU, and memory control per group.

# xe: Intel's driver for recent integrated and discrete GPUs. On a
# real-time kernel it is the only one that can be built for the GPU of
# the reference machine: in Linux 6.18 the older driver, i915, depends on
# !PREEMPT_RT. For Arrow Lake xe is still experimental in 6.18: it binds
# only when told to (module parameter force_probe=<PCI device id>).
#
# A module, and never loaded by the kernel on its own (see
# /etc/modprobe.d): dawos-tune loads it at every boot for the profiles
# that name it (graphics_driver=, ADR 0022), because a screen the
# firmware lit and no driver holds disturbs the live CPUs (step P1.0).
# A module and not built in: its firmware files are read from the root
# file system, and a boot without it stays possible (profile "generic").
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y
# CONFIG_DRM_I915 is not set

# Memory controller of control groups: without it MemoryMax= of a systemd
# unit has no effect, and ADR 0002 counts on a memory limit per process.
CONFIG_MEMCG=y
