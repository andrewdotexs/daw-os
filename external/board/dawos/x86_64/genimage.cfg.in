# dawOS disk image for QEMU (step P0.2).
# Template: post-image.sh replaces @VERSION@ and @ROOT_SLOT_SIZE@.
#
# The real NVMe is not written from this image: it is partitioned by the
# installer (step P0.4) with the full layout of document 0, section 3.3.

image efi-part.vfat {
	vfat {
		extraargs = "-n ESP"

		file EFI {
			image = "efi-part/EFI"
		}

		file loader {
			image = "efi-part/loader"
		}

		file dawos {
			image = "efi-part/dawos"
		}
	}

	size = 256M
}

image disk.img {
	hdimage {
		partition-table-type = "gpt"
	}

	partition esp {
		image = "efi-part.vfat"
		# "U" is genimage shorthand for the EFI System Partition type.
		partition-type-uuid = U
		offset = 1M
		bootable = true
	}

	# The label carries the version: it is how the kernel command line
	# finds its own root, and later how systemd-sysupdate picks a slot.
	partition "dawos-root-@VERSION@" {
		# Discoverable Partitions Specification: root, x86-64.
		partition-type-uuid = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709
		image = "rootfs.erofs"
		size = @ROOT_SLOT_SIZE@
	}
}
