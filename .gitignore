# Buildroot output tree and download cache (large, fully reproducible).
/output/
/dl/

# Signing keys and any other local secret never enter the repository.
/keys/
*.key
*.pem
*.p12

# Local, machine-specific overrides (see docs/fasi/fase-0/).
/local/

# Editor and OS noise.
*.swp
*~
.DS_Store

# Rust: build results, and the sources of the external crates, which
# "make engine-vendor" downloads and checks against Cargo.lock.
/crates/target/
/crates/vendor/

