#!/bin/sh
# dawos-audio-test — the engine on a sound card: a tone out, the same
# tone back in, and what happens when the card stops (step P1.4).
#
# The engine plays a test tone on output 3, copies input 3 to output 5
# sample for sample, and measures inputs 3 and 5 second by second. The
# tone has three cycles in a quantum (1500 Hz at 48 kHz): with it the
# engine also finds every slip of the signal (samples lost or made up on
# the way round, with no xrun to tell), to the sample. A slip of more
# than two samples fails a run; smaller ones are counted and reported
# (the Scarlett 18i20 of the second generation has them, open point
# A-58). For
# the tone to be on both, output 3 must reach input 3 and output 5 must
# reach input 5:
#
#   loopback   on the card made of software (snd-aloop), where every
#              output is wired to the input of the same number. Works on
#              any machine, a virtual one too: it proves the logic, not
#              the timing, and xruns are allowed.
#   card       on the USB interface. Output 3 reaches input 3 through a
#              cable; output 5 reaches input 5 inside the interface,
#              through its router (the file MODEL.test-loop.conf, set
#              for the test and undone after it). No xrun is allowed.
#
# An interface needs time after its streams start, and more after a
# change of sample rate: on the Scarlett 18i20 the input stops a second
# after the start, is silent, and is back after four or five seconds;
# and in the first seconds the signal slips now and then (step P1.4).
# So the plain runs of "card" do not judge their first minute (the
# warm-up): what happens there is counted apart and shown.
#
# After a change of rate the interface stops its input once, about a
# second after the streams start, and the streams started again after
# that xrun are short of a millisecond of queue: for five minutes the
# signal then slips three times by a third of a millisecond (step
# P1.6a). Streams started afresh once the rate is set do not. So before
# every run at a rate the interface was not at, the engine runs once
# for eight seconds without being judged (the line "settle-RATE"), and
# the run that counts starts its streams afresh.
#
# Cases of "loopback": the plain run, an xrun made on purpose, the card
# taken away and given back, a live thread that never yields, a run
# with the trace of the kernel on the live CPUs (step P1.6c: no system
# call in the compute phase), and a run where the thread that holds the
# card makes a system call in every compute phase (step P1.6d: the
# kernel must stop it, and the engine name it and carry it out).
#
# Cases of "card": the plain run at every rate asked for, then at the
# first rate a run with the trace of the kernel, the system call made on
# purpose, an xrun made on purpose, the live thread that holds the card
# never yielding, and one of the threads that follow it never yielding
# (step P1.6b; not with --threads 1).
#
# And in both, two cases with a graph (step P1.7c):
#
#   graph   the copy of input 3 to output 5 is made by a graph
#           (passthrough.graph) instead of the engine's own route: the
#           tone must be on both inputs as in the plain run;
#   relay   the engine plays a count on output 5, a graph for four live
#           threads (relay.graph) takes it on input 5, hands it from
#           thread to thread and plays it on output 6, and the engine
#           checks it on input 6, sample for sample. Output 6 reaches
#           input 6 as output 5 reaches input 5. Always with four live
#           threads: the graph gives each its part.
#
# In every case the engine has the kernel stop the system calls of the
# compute phase, and a call stopped where none was asked for fails the
# case. A case with a graph also has the engine's verdict "graph:": on
# the interface every cycle must compute the whole graph, and no thread
# may find a buffer of it in use by another; on the software card, where
# the time is not kept, it is enough that the graph was run.
#
# Results go to /var/lib/dawos/measure/audio-<time>[-LABEL].

set -u

PROG=dawos-audio-test
BASE=/var/lib/dawos/measure
ENGINE=${DAWOS_ENGINE:-dawos-engine}
GRAPHS=${DAWOS_GRAPHS_DIR:-/usr/share/dawos/graphs}
SETUP=${DAWOS_CARD_SETUP:-dawos-card-setup}
CARDS_DIR=${DAWOS_CARDS_DIR:-/usr/share/dawos/cards}

usage() {
	cat << USAGE
Usage:
  ${PROG} loopback [--seconds N] [LABEL]
  ${PROG} card [--card N] [--rates "HZ ..."] [--seconds N] [--warm-up N] [--periods N]
               [--threads N]
               [--no-faults] [LABEL]

  --seconds N    length of every plain run (default: 10 for loopback,
                 600 for card), after the warm-up
  --warm-up N    "card": seconds at the start of every plain run that are
                 not judged (default 60)
  --rates LIST   sample rates of the plain runs of "card" (default
                 "48000 96000 192000")
  --card N       the sound card (default: the first USB one)
  --periods N    "card": periods in the buffers of the card (default 3)
  --threads N    "card": live threads (default: the engine's own, one per
                 live CPU; the first holds the card, the others follow it)
  --no-faults    "card": the plain runs only
USAGE
}

die() {
	echo "${PROG}: $*" >&2
	exit 1
}

# Value of a "name: value" line of an output of the engine.
field() {
	sed -n "s/^$2: //p" "$1" | head -n 1
}

# Column $2 of the row of the first live thread in the thread table.
thread_column() {
	awk -v column="$2" '
		/^slot +kind +end/ { inside = 1; next }
		inside && NF == 0 { inside = 0 }
		inside && $1 == "0" && $3 != "never" { value = $column }
		END { print value }' "$1"
}

# Level of the tone on input $2, weakest and strongest second, and its
# smallest share.
heard() {
	awk -v input="$2" '
		/^input +seconds/ { inside = 1; next }
		inside && NF == 0 { inside = 0 }
		inside && $1 == input { printf "input %s tone %s to %s dB share %s", $1, $6, $7, $8 }' "$1"
}

# What the engine does with the sound in a case: the tone on output 3,
# input 3 copied to output 5, both inputs measured. A case with a graph
# sets its own before run_case, which puts this back.
PLAIN_SOUND="--tone 3 --tone-cycles 3 --route 3:5 --listen 3,5"
sound=${PLAIN_SOUND}

# Run one case: $1 name, the rest are options of "dawos-engine run". The
# verdict is the engine's own line "audio:".
run_case() {
	name=$1
	shift
	cases=$((cases + 1))
	# shellcheck disable=SC2086  # device_options and sound are several words
	"${ENGINE}" run --backend alsa ${device_options} ${sound} --each-second "$@" \
		> "${dir}/${name}.txt" 2> "${dir}/${name}.err"
	sound=${PLAIN_SOUND}
	audio=$(field "${dir}/${name}.txt" audio)
	k04=$(field "${dir}/${name}.txt" k04)
	result=FAIL
	case "${audio}" in
	PASS*)
		result=PASS
		# A case with a stuck thread also has the verdict of the
		# protection; its limits are those of the reference machine,
		# so on the software card it does not count.
		case "${mode}:${k04}" in
		card:FAIL*) result=FAIL ;;
		esac
		;;
	esac
	# A case with the trace of the kernel (step P1.6c): no system call
	# may be entered in the compute phase, and the trace must be gone
	# when the engine ends.
	# In every case the kernel stops the system calls of the compute
	# phase (step P1.6d): the engine's own verdict, "compute:", must not
	# be FAIL. In the case "syscall" a call is made there on purpose,
	# and the verdict says whether it was stopped and carried out.
	compute=$(field "${dir}/${name}.txt" compute)
	case "${compute}" in
	FAIL*) result=FAIL ;;
	esac
	# A case with a graph (step P1.7c): the engine's own verdict,
	# "graph:", must be there and must not be FAIL.
	graph=
	case " $* " in
	*" --graph "*)
		graph=$(field "${dir}/${name}.txt" graph)
		case "${graph}" in
		PASS*) ;;
		*) result=FAIL ;;
		esac
		;;
	esac
	entries=
	case " $* " in
	*" --kernel-entries "*)
		entries=$(field "${dir}/${name}.txt" kernel_entries_in_compute)
		case "${entries}" in
		"0 system calls"*) ;;
		*) result=FAIL ;;
		esac
		if [ -d /sys/kernel/tracing/instances/dawos-engine ]; then
			result=FAIL
			entries="${entries}; the trace was left behind"
		fi
		;;
	esac
	[ "${result}" = PASS ] && passed=$((passed + 1))
	{
		printf '%-18s %-5s' "${name}" "${result}"
		printf ' xruns %s, recoveries %s, lost %s; wake-up avg %s max %s us; compute avg %s max %s us; %s; %s' \
			"$(field "${dir}/${name}.txt" card_xruns)" \
			"$(field "${dir}/${name}.txt" card_recoveries)" \
			"$(field "${dir}/${name}.txt" card_lost | sed 's/ .*//')" \
			"$(thread_column "${dir}/${name}.txt" 8)" "$(thread_column "${dir}/${name}.txt" 9)" \
			"$(thread_column "${dir}/${name}.txt" 10)" "$(thread_column "${dir}/${name}.txt" 11)" \
			"$(heard "${dir}/${name}.txt" 3)" "$(heard "${dir}/${name}.txt" 5)"
		printf '; slips %s and %s' "$(field "${dir}/${name}.txt" slips_on_input_3)" \
			"$(field "${dir}/${name}.txt" slips_on_input_5)"
		# With more live threads than one: how far apart they woke, and
		# how often one of those that follow the card woke for nothing.
		spread=$(awk '$1 == "first" && $2 == "awake" { print $10 " and " $11 }' "${dir}/${name}.txt")
		[ -n "${spread}" ] && printf '; first thread awake to last, 99.99%% and most, %s us; followers: %s' \
			"${spread}" "$(field "${dir}/${name}.txt" card_followers)"
		[ -n "${k04}" ] && printf '; k04 %s' "${k04%% *}"
		[ -n "${entries}" ] && printf '; in the compute phase: %s' "${entries}"
		printf '; compute %s' "${compute:-not watched}"
		counted=$(sed -n 's/^count_on_input_\([0-9]*\): \(way round [0-9]* samples\).*/count on input \1: \2/p' "${dir}/${name}.txt")
		[ -n "${counted}" ] && printf '; %s, slips %s, out of place %s' "${counted}" \
			"$(sed -n 's/^count_slips_on_input_[0-9]*: \([0-9]*\) .*/\1/p' "${dir}/${name}.txt")" \
			"$(sed -n 's/^count_samples_on_input_[0-9]*: .* in place, \([0-9]*\) out of place.*/\1/p' "${dir}/${name}.txt")"
		[ -n "${graph}" ] && printf '; graph %s' "${graph}"
		[ -z "${graph}" ] && case " $* " in *" --graph "*) printf '; graph: no verdict' ;; esac
		# Why, in the engine's own words.
		[ "${result}" = FAIL ] && printf '; audio: %s' "${audio:-no verdict: $(tail -n 1 "${dir}/${name}.err")}"
		printf '\n'
	} >> "${dir}/summary.txt"
	tail -n 1 "${dir}/summary.txt"
}

# Bring the interface to the rate $1 and let it settle, unless it is
# there already: eight seconds of the engine, not a case of the test.
settles=0
settle() {
	[ "$1" = "${current_rate}" ] && return 0
	current_rate=$1
	settles=$((settles + 1))
	# shellcheck disable=SC2086  # device_options is several words
	"${ENGINE}" run --backend alsa ${device_options} --rate "$1" --seconds 8 --tone 3 --tone-cycles 3 --listen 3 \
		--each-second --allow-xruns --require-rt > "${dir}/settle-${settles}-$1.txt" 2> "${dir}/settle-${settles}-$1.err"
	clean=$(awk '
		/^second +input/ { inside = 1; next }
		inside && $1 !~ /^[0-9]+$/ { inside = 0 }
		inside { last = $1; if ($5 < 0.99) bad = $1 }
		END { if (last == "") print "never"; else if (bad == last) print "never"; else print bad + 1 }' "${dir}/settle-${settles}-$1.txt")
	printf '%-18s %-5s xruns %s, restarts after a pause %s; the tone is clean from second %s\n' \
		"settle-$1" "-" "$(field "${dir}/settle-${settles}-$1.txt" card_xruns)" \
		"$(field "${dir}/settle-${settles}-$1.txt" card_restarts_after_a_pause | sed 's/ .*//')" "${clean}" |
		tee -a "${dir}/summary.txt"
}

first_usb_card() {
	for directory in /proc/asound/card[0-9]*; do
		[ -r "${directory}/usbid" ] || continue
		echo "${directory##*/card}"
		return 0
	done
	return 1
}

mode=${1:-}
case "${mode}" in
loopback | card) shift ;;
-h | --help)
	usage
	exit 0
	;;
*)
	usage >&2
	exit 1
	;;
esac

seconds=
rates="48000 96000 192000"
card=
warm_up=60
periods=3
threads=
faults=yes
label=
while [ $# -gt 0 ]; do
	case "$1" in
	--seconds)
		seconds=${2:-}
		shift 2
		;;
	--rates)
		rates=${2:-}
		shift 2
		;;
	--card)
		card=${2:-}
		shift 2
		;;
	--periods)
		periods=${2:-}
		shift 2
		;;
	--warm-up)
		warm_up=${2:-}
		shift 2
		;;
	--threads)
		threads=${2:-}
		shift 2
		;;
	--no-faults)
		faults=no
		shift
		;;
	-*) die "unknown option '$1'" ;;
	*)
		label=$1
		shift
		;;
	esac
done
case "${seconds}${warm_up}" in
*[!0-9]*) die "--seconds and --warm-up take a number" ;;
esac
[ "$(id -u)" = 0 ] || die "must run as root"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
dir="${BASE}/audio-${stamp}${label:+-${label}}"
mkdir -p "${dir}" || die "cannot create ${dir}"
cases=0
passed=0
{
	echo "started_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
	echo "mode: ${mode}"
	echo "label: ${label:-none}"
	echo "kernel: $(uname -a | cut -d' ' -f1,3-)"
	# shellcheck source=/dev/null
	echo "image: $(. /etc/os-release && echo "${IMAGE_VERSION:-unknown}")"
	virtual=$(systemd-detect-virt 2> /dev/null)
	echo "virtual: ${virtual:-unknown}"
	echo "engine: $("${ENGINE}" --version 2> /dev/null)"
	echo "uptime_s: $(cut -d. -f1 /proc/uptime)"
} > "${dir}/meta.txt"
echo "directory: ${dir}"
printf '%-18s %-5s %s\n' "case" "result" "figures" > "${dir}/summary.txt"
cat "${dir}/summary.txt"

if [ "${mode}" = loopback ]; then
	loaded=no
	if [ ! -d /proc/asound/Loopback ]; then
		modprobe snd-aloop || die "cannot load snd-aloop"
		loaded=yes
		sleep 1
	fi
	device_options="--device hw:Loopback,0,0 --capture-device hw:Loopback,1,0"
	echo "card: Loopback (snd-aloop)" >> "${dir}/meta.txt"
	seconds=${seconds:-10}
	run_case plain --seconds "${seconds}" --allow-xruns
	run_case card-xrun --seconds 8 --allow-xruns --fault card-xrun
	run_case card-lost --seconds 8 --allow-xruns --fault card-lost
	run_case stuck-node --seconds 8 --allow-xruns --fault stuck-node --fault-thread 0
	run_case kernel-entries --seconds 8 --allow-xruns --kernel-entries
	run_case syscall --seconds 8 --allow-xruns --fault syscall
	sound="--tone 3 --tone-cycles 3 --listen 3,5"
	run_case graph --seconds "${seconds}" --allow-xruns --graph "${GRAPHS}/passthrough.graph"
	sound="--tone 3 --tone-cycles 3 --listen 3 --count 5:6"
	run_case relay --seconds "${seconds}" --allow-xruns --threads 4 --graph "${GRAPHS}/relay.graph"
	if [ "${loaded}" = yes ]; then
		modprobe -r snd-aloop 2> /dev/null || true
	fi
else
	if [ -z "${card}" ]; then
		card=$(first_usb_card) || die "no USB sound card: is the interface connected?"
	fi
	[ -d "/proc/asound/card${card}" ] || die "there is no sound card ${card}"
	identifier=$(cat "/proc/asound/card${card}/id")
	model=$(tr ':' '-' < "/proc/asound/card${card}/usbid" 2> /dev/null)
	device_options="--device hw:${identifier},0 --periods ${periods}${threads:+ --threads ${threads}}"
	{
		echo "card: ${identifier} (${model:-not a USB card})"
		echo "threads: ${threads:-the default of the engine}"
		echo "rates: ${rates}"
		echo "periods: ${periods}"
		echo "warm_up_s: ${warm_up}"
	} >> "${dir}/meta.txt"
	seconds=${seconds:-600}

	# The router of the interface: the known state, then the loop the
	# test needs.
	loop="${CARDS_DIR}/${model}.test-loop.conf"
	if [ -r "${CARDS_DIR}/${model}.conf" ]; then
		{
			"${SETUP}" apply --card "${card}"
			[ -r "${loop}" ] && "${SETUP}" apply --card "${card}" "${loop}"
		} > "${dir}/routing-before.txt" 2>&1
		grep -E '^(set|failed|differs|missing|bad value|read-only)' "${dir}/routing-before.txt"
	else
		echo "no state file for the card ${model}: its router is left as it is" | tee "${dir}/routing-before.txt"
	fi

	first=
	current_rate=
	for rate in ${rates}; do
		first=${first:-${rate}}
		settle "${rate}"
		run_case "plain-${rate}" --rate "${rate}" --warm-up "${warm_up}" \
			--seconds "$((seconds + warm_up))" --require-rt
	done
	# With a graph (step P1.7c), at the first rate: two minutes each
	# after the warm-up.
	settle "${first}"
	sound="--tone 3 --tone-cycles 3 --listen 3,5"
	run_case "graph-${first}" --rate "${first}" --warm-up "${warm_up}" \
		--seconds "$((120 + warm_up))" --require-rt --graph "${GRAPHS}/passthrough.graph"
	sound="--tone 3 --tone-cycles 3 --listen 3 --count 5:6"
	run_case "relay-${first}" --rate "${first}" --warm-up "${warm_up}" \
		--seconds "$((120 + warm_up))" --require-rt --threads 4 --graph "${GRAPHS}/relay.graph"
	if [ "${faults}" = yes ]; then
		settle "${first}"
		run_case "kernel-entries-${first}" --rate "${first}" --warm-up 8 --seconds 38 --require-rt \
			--kernel-entries
		run_case "syscall-${first}" --rate "${first}" --warm-up 8 --seconds 38 --require-rt \
			--fault syscall --fault-after 18
		run_case "card-xrun-${first}" --rate "${first}" --seconds 10 --require-rt --fault card-xrun
		run_case "stuck-node-${first}" --rate "${first}" --seconds 12 --require-rt --kernel-probe \
			--fault stuck-node --fault-thread 0 --fault-after 4
		# The same for a thread that follows the card, when there is one.
		if [ "${threads:-2}" -gt 1 ]; then
			run_case "stuck-follower-${first}" --rate "${first}" --seconds 12 --require-rt --kernel-probe \
				--load 20 --fault stuck-node --fault-thread 1 --fault-after 4
		fi
	fi

	if [ -r "${CARDS_DIR}/${model}.conf" ]; then
		"${SETUP}" apply --card "${card}" > "${dir}/routing-after.txt" 2>&1
		grep -E '^(set|failed|differs|missing|bad value|read-only)' "${dir}/routing-after.txt"
	fi
fi

{
	echo
	if [ "${passed}" -eq "${cases}" ]; then
		echo "verdict: PASS (${passed} of ${cases} cases)"
	else
		echo "verdict: FAIL (${passed} of ${cases} cases)"
	fi
	echo "finished_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
} | tee -a "${dir}/summary.txt"
[ "${passed}" -eq "${cases}" ]
