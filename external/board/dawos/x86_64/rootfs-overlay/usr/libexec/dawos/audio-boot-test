#!/bin/sh
# dawOS (dev variant): run the audio test on the software sound card at
# boot, for "make qemu-audio-test".
#
# The marker file is removed before anything else, so the test runs once.
# The outcome is printed on the console as one line the test reads:
#
#   DAWOS-AUDIO-TEST result=pass passed=9 cases=9
#   DAWOS-AUDIO-TEST result=fail passed=7 cases=9
#
# Before it, for every case, some lines of what the engine said, after a
# line "DAWOS-AUDIO-DETAIL case": they stay in the log of the console,
# for when a case has to be understood.

set -u

marker=/var/lib/dawos/test/audio-test

# shellcheck source=/dev/null
. /etc/os-release
[ "${VARIANT_ID:-}" = dev ] || exit 0
[ -e "${marker}" ] || exit 0
rm -f "${marker}"

if output=$(dawos-audio-test loopback boot 2>&1); then
	result=pass
else
	result=fail
fi
counts=$(echo "${output}" | sed -n 's/^verdict: [A-Z]* (\([0-9]*\) of \([0-9]*\) cases)$/passed=\1 cases=\2/p')

# What the engine said in every case, in short: nobody can go and read
# the files of a virtual machine that is switched off when the test
# ends. For each case: what it wrote as errors, the table of its
# threads, what the watchdog did, the lines about the card and the
# graph, its verdicts.
details=
directory=$(echo "${output}" | sed -n 's/^directory: //p' | head -n 1)
if [ -d "${directory}" ]; then
	for file in "${directory}"/*.txt; do
		name=${file##*/}
		name=${name%.txt}
		case "${name}" in
		meta | summary | settle-* | routing-*) continue ;;
		esac
		details="${details}
DAWOS-AUDIO-DETAIL ${name}
$(sed 's/^/  stderr: /' "${file%.txt}.err" 2> /dev/null)
$(awk '
	/^slot +kind/ || /^the graph in the cycles/ { print "  " $0; inside = 1; next }
	inside && NF == 0 { inside = 0 }
	inside { print "  " $0; next }
	/^(live_threads|scheduling|denormals|card_xruns|card_recoveries|card_restarts_after_a_pause|card_lost|card_short_writes|card_followers|card_driver_period_frames|count_[a-z_0-9]*|threads_in_place_late|graph_refused|graph_change[a-z_]*|graph_node_given_up|graph_node_not_given_up|graph_peak [a-z0-9_.]*|k04|audio|compute|graph):/ { print "  " $0 }
	/^slot [0-9]+ cycle / { print "  " $0 }' "${file}")"
	done
fi
report="${output}
${details}
DAWOS-AUDIO-TEST result=${result} ${counts:-passed=0 cases=0}"
echo "${report}"

# The test that started this reads the serial port of the virtual
# machine, which is the console only in the generic profile: in the
# others the report is written to the serial port as well (as the boot
# report does). Never on a real machine.
case " $(cat /proc/cmdline) " in
*" console=ttyS0"*) ;;
*)
	if [ -w /dev/ttyS0 ] && systemd-detect-virt --quiet --vm 2> /dev/null; then
		echo "${report}" > /dev/ttyS0 2> /dev/null || true
	fi
	;;
esac
